---
/**
 * A heading whose words arrive one after another as it scrolls into view.
 *
 * The split happens at build time, so the heading's textContent is exactly
 * the string it was given — a screen reader, a search engine and the suite's
 * "headline matches the heading" checks all read one sentence, not a list of
 * spans. Each word sits inside a clipped box and is moved below it with a
 * transform; colour and opacity never change, so the contrast checks see the
 * same text at every moment of the reveal.
 *
 * The hidden state exists only under `html.js-reveal`, which `Reveal.ts` sets
 * when it runs: without JavaScript every word is simply visible. Under
 * reduced motion the words never move; the heading eases from half to full
 * opacity instead, so it is never invisible on the way in.
 */
interface Props {
  as?: "h1" | "h2" | "h3";
  text: string;
  class?: string;
}

const { as: Tag = "h2", text, class: className } = Astro.props;
const words = text.trim().split(/\s+/);
---

{/* Written on one line on purpose: any newline or indent inside the tag
    would become text between the words, and the heading's textContent is
    meant to be exactly the string it was given. */}
<Tag class:list={["split", className]} data-split>{words.map((word, i) => <><span class="split__w"><span class="split__i" style={`--i:${i}`}>{word}</span></span>{i < words.length - 1 ? " " : ""}</>)}</Tag>

<style lang="scss">
  .split__w {
    display: inline-block;
    /* Clip the word's travel, with a little room below the baseline so
       descenders are not cut while the word is at rest. */
    overflow: clip;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
    vertical-align: top;
  }

  .split__i {
    display: inline-block;
  }

  /* The travel. One compositor transition per word, staggered by its index;
     no loop runs, nothing is written per frame. */
  :global(html.js-reveal) .split__i {
    transform: translateY(105%);
    transition: transform 800ms cubic-bezier(0.2, 0.7, 0.1, 1);
    transition-delay: calc(var(--i, 0) * 45ms);
  }

  :global(html.js-reveal) .split.is-in .split__i {
    transform: none;
  }

  /* The alternate ending: no travel, a short fade from half to full. */
  @media (prefers-reduced-motion: reduce) {
    :global(html.js-reveal) .split__i {
      transform: none;
      transition: none;
    }

    :global(html.js-reveal) .split {
      opacity: 0.5;
      transition: opacity 300ms ease;
    }

    :global(html.js-reveal) .split.is-in {
      opacity: 1;
    }
  }
</style>
