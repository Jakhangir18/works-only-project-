---
import { timeline, KIND_LABEL, when } from "../data/timeline";

/**
 * The owner's time at Oregon State, as a short list after the work: the
 * research, the lab he is in now, and the two hackathons — each one row, in
 * the same dark sheet and palette as the work above it.
 *
 * Rows come from the timeline, not from a second list: an entry marked
 * `campus` is shown here, in the board's own order, and a draft stays out
 * until the owner confirms it. Nothing here runs in the browser.
 */

const rows = timeline
  .filter((entry) => entry.campus && !entry.draft)
  .sort((a, b) => b.start.localeCompare(a.start))
  .map((entry) => ({
    ...entry,
    label: `${KIND_LABEL[entry.kind] ?? entry.kind}${entry.status ? ` · ${entry.status}` : ""}`,
    live: entry.status === "in progress",
    date: when(entry.start, entry.end),
  }));
---

<section class="campus" id="campus" aria-labelledby="campus-title">
  <div class="campus__inner">
    <p class="campus__kicker">At Oregon State</p>
    <h2 class="campus__title" id="campus-title">Computer science and physics, and the lab after class.</h2>

    <ol class="campus__rows">
      {
        rows.map((row) => (
          <li class="campus__row">
            <span class:list={["campus__pill", { "campus__pill--live": row.live }]}>{row.label}</span>
            <div class="campus__body">
              <h3 class="campus__name">
                {row.href ? <a href={row.href}>{row.title}</a> : row.title}
              </h3>
              <p class="campus__line">{row.summary}</p>
            </div>
            <p class="campus__meta">
              <span class="campus__org">{row.org}</span>
              {/* Machine-readable like the board's: one <time> per end of the span. */}
              <span class="campus__date">
                {row.date.to ? (
                  <>
                    <time datetime={row.start}>{row.date.from}</time> – <time datetime={row.end}>{row.date.to}</time>
                  </>
                ) : row.end ? (
                  <time datetime={row.start}>{row.date.text}</time>
                ) : (
                  <>
                    <time datetime={row.start}>{row.date.from}</time> — now
                  </>
                )}
              </span>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style lang="scss">
  @use "../styles/helpers/colors" as *;
  @use "../styles/helpers/fonts" as *;
  @use "../styles/helpers/responsive" as *;

  .campus {
    background: color(space);
    color: color(work-text);
    padding: clamp(3rem, 8vh, 6rem) clamp(1.5rem, 5vw, 5rem) clamp(4rem, 10vh, 8rem);
  }

  .campus__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .campus__kicker {
    margin: 0 0 0.75rem;
    font: 700 0.6875rem / 1 font-family(fraktion);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color(work-muted);
  }

  .campus__title {
    margin: 0 0 clamp(1.5rem, 4vh, 2.5rem);
    max-width: 22ch;
    font: 400 clamp(1.75rem, 3.6vw, 2.75rem) / 1.08 font-family(editorial);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .campus__rows {
    margin: 0;
    padding: 0;
    list-style: none;

    border: 1px solid color(work-border);
    border-radius: 6px;
    background: color(work-surface);
  }

  .campus__row {
    display: grid;
    /* A fixed first track, so the titles line up down the list whatever each
       row's pill says; the widest pill is "Research · in progress". */
    grid-template-columns: 11.5rem 1fr auto;
    gap: 0.5rem 1.25rem;
    align-items: start;
    padding: 1.125rem 1.25rem;

    & + & {
      border-top: 1px solid color(work-border);
    }
  }

  .campus__pill {
    display: inline-block;
    /* Its own width, not the track's: a grid item stretches otherwise. */
    justify-self: start;
    margin-top: 0.2em;
    padding: 0.35em 0.7em;
    border: 1px solid color(work-border);
    border-radius: 999px;
    white-space: nowrap;

    font: 700 0.6875rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color(work-muted);
  }

  .campus__pill--live {
    border-color: transparent;
    background: color(work-green-bg);
    color: color(work-green);
  }

  .campus__name {
    margin: 0 0 0.25rem;
    font: 600 1.0625rem / 1.3 font-family(geist);
    letter-spacing: -0.01em;

    a {
      color: inherit;
      text-decoration: none;
      text-underline-offset: 0.18em;

      &:hover,
      &:focus-visible {
        text-decoration: underline;
      }
    }
  }

  .campus__line {
    margin: 0;
    max-width: 60ch;
    font: 400 0.9375rem / 1.55 font-family(geist);
    color: color(work-muted);
  }

  .campus__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    margin: 0;
    text-align: right;

    font: 400 0.75rem / 1.3 font-family(fraktion);
    color: color(work-muted);
  }

  @include mq(tablet-sm) {
    .campus__row {
      grid-template-columns: 1fr;
    }

    .campus__meta {
      align-items: flex-start;
      text-align: left;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.35rem 1rem;
    }
  }
</style>
