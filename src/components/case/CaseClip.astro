---
import { video } from "../../data/media";

/**
 * A clip from the project's imported media. Nothing downloads until it is
 * needed (preload="none", a poster in its place).
 *
 * `loop` clips are silent footage: they play muted while on screen and pause
 * off it (case.ts, one IntersectionObserver for the page). Other clips are
 * for watching: native controls, the reader presses play. `sound` says the
 * clip has its own audio worth hearing; it is never autoplayed.
 */
interface Props {
  slug: string;
  id: string;
  label: string;
  caption?: string;
  n?: number;
  loop?: boolean;
  class?: string;
}
const { slug, id, label, caption, n, loop = false, class: className } = Astro.props;
const v = video(slug, id);
// Round the whole length once, then split it, so 59.6 s reads 1:00, not 0:60.
const total = Math.round(v.duration);
const mins = Math.floor(total / 60);
const secs = String(total % 60).padStart(2, "0");
---

<figure class:list={["case-clip", className]} data-reveal>
  <div class="case-clip__frame" style={`aspect-ratio:${v.width} / ${v.height}`}>
    {loop ? (
      <video class="js-case-loop" src={v.src} poster={v.poster} preload="none" muted playsinline loop aria-label={label} width={v.width} height={v.height}></video>
    ) : (
      <video src={v.src} poster={v.poster} preload="none" controls playsinline aria-label={label} width={v.width} height={v.height}></video>
    )}
  </div>
  {caption && (
    <figcaption>
      {n !== undefined && <span class="case-clip__n">Fig. {n}</span>}
      <span>{caption}</span>
      <span class="case-clip__len">{mins}:{secs}</span>
    </figcaption>
  )}
</figure>

<style lang="scss">
  @use "../../styles/helpers/fonts" as *;

  .case-clip {
    margin: 0;
  }

  .case-clip__frame {
    overflow: hidden;
    border-radius: 12px;
    background: #000;

    video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  figcaption {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.7rem;
    font: 400 0.8125rem / 1.45 font-family(geist);
    color: var(--case-soft);
  }

  .case-clip__n,
  .case-clip__len {
    flex: none;
    font: 400 0.6875rem / 1.9 font-family(fraktion);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--case-ink);
  }

  .case-clip__len {
    margin-left: auto;
    color: var(--case-soft);
  }
</style>
