---
import { works } from "../data/works";
import { timeline } from "../data/timeline";

/**
 * The work: one bordered panel per project on a dark sheet, a corner label,
 * a very large title, a couple of tags, a way in, and the project's own
 * photograph large. The look is GitHub's dark palette — canvas, a surface
 * one step lighter, hairline borders, pills — on the black the rocket's
 * burst left behind.
 *
 * No pinning and no scrub. Each panel is an ordinary full-height section,
 * which is exactly why the reference scrolls as smoothly as it does — the
 * browser is doing nothing but scrolling.
 *
 * The tags are not invented. Each one is the kind and the year already
 * confirmed for that project in the timeline, matched by route; a project with
 * no timeline entry simply shows fewer tags rather than a guess.
 */

const KIND_LABEL: Record<string, string> = {
  work: "Work",
  research: "Research",
  competition: "Competition",
  club: "Club",
};

function tagsFor(site: string): string[] {
  const entry = timeline.find((item) => item.href === site);
  if (!entry) return [];
  const year = entry.start.slice(0, 4);
  return [KIND_LABEL[entry.kind] ?? entry.kind, year];
}

const panels = works.map((work, index) => ({
  ...work,
  index: String(index + 1).padStart(2, "0"),
  tags: tagsFor(work.site),
}));
---

<section class="anime-work" id="work" aria-label="Work">
  {
    panels.map((panel) => (
      <article class="anime-work__panel">
        <p class="anime-work__label">Case {panel.index}</p>

        <div class="anime-work__inner">
          <div class="anime-work__media">
            {panel.cover ? (
              <img
                src={panel.cover.src}
                alt={panel.cover.alt}
                width={panel.cover.width}
                height={panel.cover.height}
                loading="lazy"
                decoding="async"
                style={`object-position:${panel.cover.focalPoint.x} ${panel.cover.focalPoint.y};`}
              />
            ) : (
              <div class="anime-work__poster" aria-hidden="true">
                <span>{panel.poster.mark}</span>
              </div>
            )}
          </div>

          <div class="anime-work__copy">
            <h2 class="anime-work__title">{panel.title}</h2>
            <p class="anime-work__blurb">{panel.blurb}</p>

            {panel.tags.length > 0 && (
              <ul class="anime-work__tags">
                {panel.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}

            <a class="anime-work__link" href={panel.site}>
              Deep dive
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    ))
  }
</section>

<style lang="scss">
  @use "../styles/helpers/colors" as *;
  @use "../styles/helpers/fonts" as *;
  @use "../styles/helpers/responsive" as *;

  .anime-work {
    position: relative;
    /* The black the burst left behind, the same token the wipe and the star
       field paint, so the work sits inside that dark rather than after it. */
    background: color(space);
    color: color(work-text);
    padding: clamp(3rem, 8vh, 6rem) clamp(1rem, 4vw, 3rem) clamp(2rem, 5vh, 4rem);
    /* The two pseudo-elements below sit under the panels and over the ground,
       so they rank inside this box only. */
    isolation: isolate;

    /* The star field's tail. The drifting layers above settle to .4 and hand
       off to this: a static scatter over the top of the sheet, painted once,
       with no element to move. Three dot grids with coprime periods read as
       scatter rather than as a grid; the second pseudo-element fades them
       into the ground over the first sixty percent of a screen. */
    &::before,
    &::after {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      z-index: -1;
      height: 60svh;
      pointer-events: none;
    }

    &::before {
      background-image:
        radial-gradient(circle, rgba(255, 255, 255, 0.7) 0.6px, transparent 1.3px),
        radial-gradient(circle, rgba(255, 217, 168, 0.6) 0.8px, transparent 1.6px),
        radial-gradient(circle, rgba(255, 255, 255, 0.45) 0.5px, transparent 1.1px);
      background-size:
        137px 149px,
        211px 173px,
        97px 83px;
      background-position:
        17px 23px,
        89px 61px,
        41px 7px;
      opacity: 0.4;
    }

    &::after {
      background: linear-gradient(to bottom, transparent, color(space));
    }
  }

  .anime-work__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;

    max-width: 1180px;
    min-height: min(100svh, 46rem);
    margin: 0 auto clamp(1rem, 2.5vh, 1.5rem);
    padding: 5rem clamp(1.5rem, 4vw, 4rem) 3.5rem;

    /* One bordered box per project, the surface one step up from the canvas,
       as GitHub draws a box: a hairline, a small radius, no shadow. */
    border: 1px solid color(work-border);
    border-radius: 6px;
    background: color(work-surface);

    /* Even panels put the media on the right, as the reference alternates
       its cases. */
    &:nth-child(even) {
      .anime-work__inner {
        grid-template-columns: 1fr 1.15fr;
      }

      .anime-work__media {
        order: 2;
      }
    }
  }

  .anime-work__label {
    position: absolute;
    top: 1.5rem;
    left: clamp(1.5rem, 4vw, 4rem);
    margin: 0;
    padding: 0.35em 0.75em;

    border: 1px solid color(work-border);
    border-radius: 999px;

    font: 700 0.6875rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color(work-muted);
  }

  .anime-work__inner {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    width: 100%;
  }

  .anime-work__media {
    position: relative;

    img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-fit: cover;

      border: 1px solid color(work-border);
      border-radius: 6px;
      /* Straight, as a screenshot sits in a readme; the shadow lifts it off
         the surface a little. Static, so it is rastered once at this size. */
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    }
  }

  .anime-work__poster {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border: 1px solid color(work-border);
    border-radius: 6px;
    background: color(space);

    span {
      font: 400 clamp(3rem, 8vw, 6rem) / 1 font-family(bigger);
      color: color(work-muted);
    }
  }

  .anime-work__title {
    margin: 0 0 1rem;
    font: 400 clamp(2.25rem, 5.2vw, 4.25rem) / 1.02 font-family(editorial);
    letter-spacing: -0.025em;
  }

  .anime-work__blurb {
    margin: 0 0 1.5rem;
    max-width: 34ch;
    font: 400 clamp(0.9375rem, 1.2vw, 1.0625rem) / 1.65 font-family(geist);
    /* The muted grey is 5.7:1 on the surface: behind the heading, above the
       4.5 this size needs. */
    color: color(work-muted);
  }

  .anime-work__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    padding: 0;
    list-style: none;

    li {
      padding: 0.35em 0.75em;
      border: 1px solid color(work-border);
      border-radius: 999px;

      font: 700 0.6875rem / 1 font-family(fraktion);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: color(work-muted);
    }

    /* The first tag is the kind; it takes the one green, on its own ground,
       the way a topic or a status reads on GitHub. */
    li:first-child {
      border-color: transparent;
      background: color(work-green-bg);
      color: color(work-green);
    }
  }

  .anime-work__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.125rem;

    border: 1px solid color(work-border);
    border-radius: 6px;
    background: color(work-surface);

    font: 700 0.75rem / 1 font-family(fraktion);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: color(work-text);

    transition: border-color 200ms ease, background-color 200ms ease;

    &:hover,
    &:focus-visible {
      border-color: color(work-muted);
      background: color(work-border);
    }
  }

  @include mq(tablet-sm) {
    .anime-work__panel {
      min-height: 0;
      padding: 4.5rem 1.25rem 2.5rem;
    }

    /* Written at the even-panel selector's specificity too, or the alternate
       two-column grid above would survive into one-column widths and split a
       390px panel into two narrow tracks. */
    .anime-work__inner,
    .anime-work__panel:nth-child(even) .anime-work__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .anime-work__panel:nth-child(even) .anime-work__media {
      order: 0;
    }

    .anime-work__blurb {
      max-width: none;
    }
  }
</style>
