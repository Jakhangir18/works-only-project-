---
import { projects } from "../data/projects";
import { STACK } from "../utils/workStack";

/**
 * WORK: the word rows. The owner's choice (2026-10-03), after the old
 * Vercel tunnel he liked: the vertical W / O / R / K stack opens into four
 * rows of its own letters, the seven projects sit inside the rows as photo
 * "words", and as the page scrolls each one in turn grows out of its row
 * into a large card, then goes back. Research: Codrops LinesToLayout ("a
 * typography row view with inline images to a large image preview") and
 * the old tunnel on main (SWork.astro). Labels say what, when and where,
 * never a position.
 *
 * The section starts one screen early, over the star field's last screen
 * (the AnimeSpace pattern), so it pins on the very scroll where the field
 * lets go; the stack here sits on the pixels the constellation drew
 * (utils/workStack.ts), and the controller shows it only while its trigger
 * is active. One sticky stage, one ScrollTrigger (WorkRows.ts). Per frame:
 * one transform per row track, the two sides' transforms while the rows
 * open, one preview's transform and a few opacities, all through
 * writeIfChanged. No 3D and no blurred shadows.
 *
 * Keyboard: each project's photo in its row is a link; focusing one scrolls
 * to the place where its card is open. Reduced motion: a still wall and the
 * plain list below it.
 */

/* Letter cells on each side of a row's centre letter: enough to cover a
   2560 px screen's half-width plus the furthest drift. */
const SIDE = 18;

/* Where each project sits: its row, the side of the centre letter, and how
   many cells out. The order of the stops is the projects' order in
   projects.ts; WorkRows.ts drifts each row so a project's photo crosses the
   middle of the screen at its stop. */
const PLACES: Record<string, { row: number; side: -1 | 1; at: number }> = {
  touchpoint: { row: 0, side: 1, at: 2 },
  spoot: { row: 1, side: 1, at: 1 },
  zyp: { row: 2, side: -1, at: 2 },
  gdg: { row: 0, side: 1, at: 9 },
  "remote-lab-vision": { row: 2, side: 1, at: 4 },
  ams: { row: 1, side: -1, at: 6 },
  "engineering-rocket": { row: 3, side: -1, at: 5 },
};

const items = projects.map((p, stop) => ({ ...p, stop, place: PLACES[p.slug] }));

type Cell = { kind: "letter"; letter: string } | { kind: "slot"; item: (typeof items)[number] };

/* One side of a row, listed outward from the centre letter. */
function side(row: number, dir: -1 | 1): Cell[] {
  return Array.from({ length: SIDE }, (_, i) => {
    const item = items.find((x) => x.place.row === row && x.place.side === dir && x.place.at === i + 1);
    return item ? { kind: "slot", item } : { kind: "letter", letter: STACK[row] };
  });
}

const rows = STACK.map((letter, row) => ({ letter, left: side(row, -1).reverse(), right: side(row, 1) }));

/* What a preview card shows, handed to the controller once. */
const cards = items.map((p) => ({
  href: p.href,
  title: p.title,
  kind: p.kind,
  line: p.result ?? p.role,
  when: `${p.when} · ${p.where}`,
  thumb: p.cover.thumb,
  src: p.cover.src,
  srcset: p.cover.srcset,
  alt: p.cover.alt,
  focal: p.cover.focal,
}));
---

<section class="anime-work" id="work" aria-labelledby="work-title">
  <h2 class="u-sr-only" id="work-title">Work</h2>

  <div class="anime-work__stage js-work-stage" data-cards={JSON.stringify(cards)}>
    <div class="anime-work__grid js-work-grid" aria-hidden="true"></div>

    <div class="anime-work__rows js-work-rows">
      {rows.map((r, row) => (
        <div class="anime-work__row">
          <div class="anime-work__track js-work-track" data-row={row}>
            <div class="anime-work__side js-work-side" data-dir="-1">
              {r.left.map((c) =>
                c.kind === "letter" ? (
                  <span class="anime-work__cell" aria-hidden="true">{c.letter}</span>
                ) : (
                  <a class="anime-work__slot js-work-slot" href={c.item.href} data-stop={c.item.stop} aria-label={`${c.item.title}: ${c.item.result ?? c.item.role}`}>
                    <img src={c.item.cover.thumb} alt="" width="480" height="640" loading="lazy" decoding="async" draggable="false" style={`object-position:${c.item.cover.focal}`} />
                  </a>
                ),
              )}
            </div>
            <span class="anime-work__cell anime-work__cell--centre js-work-centre" aria-hidden="true">{r.letter}</span>
            <div class="anime-work__side js-work-side" data-dir="1">
              {r.right.map((c) =>
                c.kind === "letter" ? (
                  <span class="anime-work__cell" aria-hidden="true">{c.letter}</span>
                ) : (
                  <a class="anime-work__slot js-work-slot" href={c.item.href} data-stop={c.item.stop} aria-label={`${c.item.title}: ${c.item.result ?? c.item.role}`}>
                    <img src={c.item.cover.thumb} alt="" width="480" height="640" loading="lazy" decoding="async" draggable="false" style={`object-position:${c.item.cover.focal}`} />
                  </a>
                ),
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Two previews, used in turn: while one shrinks back into its row the
        next can already be decoding its photograph. The rows' links are the
        keyboard path, so these stay out of the tab order. */}
    {[0, 1].map(() => (
      <a class="anime-work__preview js-work-preview" href="#work" tabindex="-1" aria-hidden="true" draggable="false">
        <span class="anime-work__shot">
          <img class="js-work-preview-img" alt="" draggable="false" />
        </span>
        <span class="anime-work__info js-work-preview-info">
          <span class="anime-work__kind js-work-preview-kind"></span>
          <span class="anime-work__title js-work-preview-title"></span>
          <span class="anime-work__line js-work-preview-line"></span>
          <span class="anime-work__when js-work-preview-when"></span>
          <span class="anime-work__open">Open the case <span aria-hidden="true">→</span></span>
        </span>
      </a>
    ))}
  </div>

  {/* The same seven, plainly: what a screen reader lists after the section's
      heading, and what reduced motion shows under the still wall. */}
  <ul class="anime-work__list">
    {items.map((p) => (
      <li>
        <a class="anime-work__entry" href={p.href} tabindex="-1">
          <img src={p.cover.thumb} alt="" width="480" height="640" loading="lazy" decoding="async" style={`object-position:${p.cover.focal}`} />
          <span class="anime-work__entry-kind">{p.kind}</span>
          <span class="anime-work__entry-title">{p.title}</span>
          <span class="anime-work__entry-line">{p.result ?? p.role}</span>
          <span class="anime-work__entry-when">{p.when} · {p.where}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<script>
  import { initWorkRows } from "../utils/WorkRows";
  initWorkRows();
</script>

<style lang="scss">
  @use "../styles/helpers/colors" as *;
  @use "../styles/helpers/fonts" as *;

  .anime-work {
    position: relative;
    /* One screen up, over the star field's last screen, so this section
       pins on the scroll where that one lets go; the first screen paints
       nothing, and the field shows through it. The stage is held for the
       rest: the rows opening, seven stops, a short tail. */
    margin-top: -100svh;
    height: 680svh;
    background: linear-gradient(to bottom, transparent 0 100svh, color(space) 100svh);
    color: color(work-text);
    /* clip, not hidden: hidden would make this a scroll container and the
       stage would stick to it instead of to the viewport. */
    overflow: clip;
    isolation: isolate;
  }

  .anime-work__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
  }

  /* The old tunnel's dot grid, static; the controller fades it in as the
     rows open, so it is not there over the star field before the pin. */
  .anime-work__grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255, 242, 237, 0.16) 1px, transparent 1.4px);
    background-size: 28px 28px;
    background-position: center;
    opacity: 0;
  }

  /* The four rows. Kept in step with utils/workStack.ts: 6svh above and
     below, four equal rows, the letters at clamp(56px, min(19svh, 30vw),
     190px) with line-height 1 — the constellation draws its letters from
     those numbers. */
  .anime-work__rows {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: repeat(4, 1fr);
    padding: 6svh 0;
    font: 400 clamp(56px, min(19svh, 30vw), 190px) / 1 font-family(bigger);
    color: #fff2ed;
  }

  .anime-work__row {
    position: relative;
  }

  /* A row's letters and photographs in one line, its centre letter on the
     stage's centre: the controller writes the track's whole transform. */
  .anime-work__track {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    align-items: center;
    height: 1em;
    margin-top: -0.5em;
    white-space: nowrap;
    will-change: transform;
  }

  .anime-work__side {
    display: flex;
    align-items: center;
    /* Folded in behind the centre letter until the rows open. */
    opacity: 0;
  }

  .anime-work__cell {
    flex: 0 0 auto;
    width: 0.8em;
    text-align: center;
  }

  /* Hidden until the section's trigger is active: before that, the star
     field's constellation draws this letter on the same pixels. */
  .anime-work__cell--centre {
    visibility: hidden;
  }

  .anime-work:global(.is-on) .anime-work__cell--centre {
    visibility: visible;
  }

  /* A photograph the height of a letter, 3:4 like every cover and like the
     preview it grows into, so the growth is one uniform scale. */
  .anime-work__slot {
    flex: 0 0 auto;
    display: block;
    width: 0.6em;
    height: 0.8em;
    margin: 0 0.1em;
    overflow: hidden;
    border-radius: 0.06em;
    background: #16161a;
    -webkit-user-drag: none;

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &:focus-visible {
      outline: 2px solid color(accent);
      outline-offset: 4px;
    }
  }

  /* Far away the tracks keep their place in the tree (the photographs are
     the keyboard path) and only stop asking for their own layers. */
  .anime-work:global(.is-far) .anime-work__track {
    will-change: auto;
  }

  /* --- The preview ------------------------------------------------------- */

  /* Laid out at its full size with the photograph's box centred on its
     place; the controller scales it down onto a row's photograph and back
     (invariant 7: it only ever downsamples). */
  .anime-work__preview {
    --shot-h: min(62svh, 560px);
    position: absolute;
    left: 40%;
    top: 50%;
    width: calc(var(--shot-h) * 0.75);
    height: var(--shot-h);
    margin: calc(var(--shot-h) / -2) 0 0 calc(var(--shot-h) * -0.375);
    color: color(work-text);
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    -webkit-user-drag: none;

    &:global(.is-up) {
      pointer-events: auto;
    }

    &:global(.is-focus) .anime-work__shot {
      outline: 2px solid color(accent);
      outline-offset: 6px;
    }
  }

  .anime-work__shot {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    /* The same corner as the row's photograph at its size: 0.06em of a
       letter, about 10px. */
    border-radius: 12px;
    border: 1px solid color(work-border);
    background: #16161a;

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .anime-work__info {
    position: absolute;
    left: calc(100% + clamp(1.5rem, 3vw, 3rem));
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    width: min(30vw, 26rem);
    opacity: 0;
  }

  .anime-work__kind {
    align-self: flex-start;
    padding: 0.3em 0.65em;
    border: 1px solid color(work-border);
    border-radius: 999px;
    font: 400 0.6875rem / 1 font-family(fraktion);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color(work-muted);
  }

  .anime-work__title {
    font: 400 clamp(2.6rem, 5.4vw, 5.6rem) / 0.88 font-family(bigger);
    text-transform: uppercase;
    color: #fff;
  }

  .anime-work__line {
    font: 400 clamp(1.05rem, 1.4vw, 1.3rem) / 1.3 font-family(editorial);
    color: #ffd9a8;
  }

  .anime-work__when {
    font: 400 0.75rem / 1.45 font-family(fraktion);
    letter-spacing: 0.06em;
    color: color(work-muted);
  }

  .anime-work__open {
    margin-top: 0.6rem;
    font: 700 0.6875rem / 1 font-family(fraktion);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color(accent);
  }

  /* --- The plain list ---------------------------------------------------- */

  .anime-work__list {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    list-style: none;
  }

  /* A phone: the photograph centred higher, the words under it. The star
     field sits at z-index 3 there (over the flight's stage, AnimeSpace.astro)
     and this section's first screen lies over its last one, so this one
     has to stack above it. */
  @media (max-width: 639.98px) {
    .anime-work {
      z-index: 4;
    }

    .anime-work__preview {
      --shot-h: min(46svh, calc(64vw / 0.75));
      left: 50%;
      top: 40%;
    }

    .anime-work__info {
      left: 50%;
      top: calc(100% + 1.1rem);
      bottom: auto;
      width: 86vw;
      transform: translateX(-50%);
      align-items: center;
      text-align: center;
    }

    .anime-work__kind {
      align-self: center;
    }

    .anime-work__title {
      font-size: clamp(2.2rem, 11vw, 3.2rem);
    }
  }

  /* Stillness, not absence: the wall stands still and open, and the seven
     are listed under it as plain cards. */
  @media (prefers-reduced-motion: reduce) {
    .anime-work {
      margin-top: 0;
      height: auto;
      padding-bottom: 10svh;
      background: color(space);
    }

    .anime-work__stage {
      position: relative;
    }

    .anime-work__grid,
    .anime-work__side {
      opacity: 1;
    }

    .anime-work__cell--centre {
      visibility: visible;
    }

    .anime-work__track {
      transform: translateX(-50%);
      will-change: auto;
    }

    .anime-work__preview {
      display: none;
    }

    .anime-work__list {
      position: static;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
      gap: 1.25rem;
      width: auto;
      height: auto;
      margin: 0;
      padding: 0 clamp(1rem, 4vw, 3rem);
      overflow: visible;
      clip: auto;
      white-space: normal;
    }
  }

  .anime-work__entry {
    display: grid;
    gap: 0.4rem;
    color: color(work-text);
    text-decoration: none;

    img {
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 4;
      object-fit: cover;
      border-radius: 12px;
    }
  }

  .anime-work__entry-kind,
  .anime-work__entry-when {
    font: 400 0.6875rem / 1.4 font-family(fraktion);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color(work-muted);
  }

  .anime-work__entry-title {
    font: 400 2rem / 0.95 font-family(bigger);
    text-transform: uppercase;
    color: #fff;
  }

  .anime-work__entry-line {
    font: 400 1rem / 1.35 font-family(editorial);
    color: #ffd9a8;
  }
</style>
