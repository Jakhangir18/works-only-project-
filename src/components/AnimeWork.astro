---
import { projects } from "../data/projects";

/**
 * WORK: out of the star field, the four letters of the old tunnel, and then
 * his experience on a 3D carousel.
 *
 * Owner's direction (2026-10-02): after space, a proper hand-off into the
 * WORK section the Vercel version has — the letter tunnel — but more
 * beautiful, with a carousel, holding his experience.
 *
 * One sticky stage held for the section's length, driven by one ScrollTrigger
 * (WorkCarousel.ts), in three acts:
 *   1. the letters W O R K rise out of the dark, one after another, stacked
 *      the way the tunnel opens;
 *   2. each letter becomes a ring of itself turning around the screen — the
 *      tunnel's rows — and the rings dim into a backdrop;
 *   3. the seven projects on a ring of cards turn through the front, one per
 *      seventh of the remaining scroll; dragging turns it too.
 *
 * Per frame: one transform per letter ring, one for the card ring, a few
 * opacities, all through writeIfChanged. The card at the front is laid out
 * at its on-screen size (the ring is pulled back by its own radius), so the
 * card being read is never an upscaled raster (invariant 7).
 */

const LETTERS = ["W", "O", "R", "K"];
/* Copies of each letter round its ring. The ring is concave (its far half
   faces the screen and its sides come forward past the screen's edges), so
   about half of them are ever drawn; backface-visibility drops the rest. */
const PER_RING = 12;

const cards = projects.map((p, i) => ({ ...p, index: String(i + 1).padStart(2, "0") }));
---

<section class="anime-work" id="work" aria-labelledby="work-title">
  <h2 class="u-sr-only" id="work-title">Work</h2>

  <div class="anime-work__stage js-work-stage">
    <div class="anime-work__tunnel" aria-hidden="true">
      {LETTERS.map((letter, row) => (
        <div class="anime-work__ring js-work-ring" style={`--row:${row}`}>
          {Array.from({ length: PER_RING }, (_, i) => (
            <span class:list={["anime-work__letter js-work-letter", { "is-front": i === 0 }]} style={`--i:${i}; --n:${PER_RING}`}>{letter}</span>
          ))}
        </div>
      ))}
    </div>

    {/* Dims the tunnel into a backdrop for the third act: an overlay's
        opacity, because opacity on a ring would flatten its 3D. */}
    <div class="anime-work__veil js-work-veil" aria-hidden="true"></div>

    <div class="anime-work__carousel js-work-carousel">
      <ul class="anime-work__cards js-work-cards" style={`--n:${cards.length}`}>
        {cards.map((card, i) => (
          <li class="anime-work__slot" style={`--i:${i}`}>
            <a class="anime-work__card js-work-card" href={card.href} data-index={i} draggable="false">
              <span class="anime-work__media">
                <img
                  draggable="false"
                  src={card.cover.src}
                  srcset={card.cover.srcset}
                  sizes="(max-width: 40em) 72vw, 360px"
                  alt={card.cover.alt}
                  width={card.cover.width}
                  height={card.cover.height}
                  loading="lazy"
                  decoding="async"
                  style={`object-position:${card.cover.focal}`}
                />
              </span>
              <span class="anime-work__body">
                <span class="anime-work__meta">
                  <span class="anime-work__kind">{card.kind}</span>
                  <span class="anime-work__index">{card.index} / {String(cards.length).padStart(2, "0")}</span>
                </span>
                <span class="anime-work__title">{card.title}</span>
                <span class="anime-work__role">{card.role}</span>
                <span class="anime-work__when">{card.when} · {card.where}</span>
                {card.result && <span class="anime-work__result">{card.result}</span>}
                <span class="anime-work__open">Open the case <span aria-hidden="true">→</span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <p class="anime-work__hint" aria-hidden="true">
      <span class="js-work-count">01</span> / {String(cards.length).padStart(2, "0")} · scroll<span class="anime-work__drag"> or drag</span>
    </p>
  </div>
</section>

<script>
  import { initWorkCarousel } from "../utils/WorkCarousel";
  initWorkCarousel();
</script>

<style lang="scss">
  @use "../styles/helpers/colors" as *;
  @use "../styles/helpers/fonts" as *;

  .anime-work {
    position: relative;
    /* The stage is held for the whole height; the acts are fractions of it. */
    height: 560svh;
    background: color(space);
    color: color(work-text);
    /* clip, not hidden: hidden would make this a scroll container and the
       stage would stick to it instead of to the viewport. */
    overflow: clip;
    isolation: isolate;

    /* The star field's tail, handed over from space: a static scatter over
       the top of the section, painted once. */
    &::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      z-index: -1;
      height: 100svh;
      background-image:
        radial-gradient(circle, rgba(255, 255, 255, 0.7) 0.6px, transparent 1.3px),
        radial-gradient(circle, rgba(255, 217, 168, 0.6) 0.8px, transparent 1.6px),
        radial-gradient(circle, rgba(255, 255, 255, 0.45) 0.5px, transparent 1.1px);
      background-size:
        137px 149px,
        211px 173px,
        97px 83px;
      background-position:
        17px 23px,
        89px 61px,
        41px 7px;
      opacity: 0.4;
      pointer-events: none;
    }
  }

  /* Out of the tree while the section is more than a screen away: its
     forty-odd 3D layers otherwise sit in the page's layer tree and are
     re-assigned on every frame the rocket or the stars write, which on a
     phone profile cost long tasks in sections nowhere near this one. The
     controller sets is-far from an IntersectionObserver. */
  /* Far away, the tunnel's letters leave the tree, and the cards stay in it
     but go flat: still in the keyboard's tab order from anywhere on the
     page, no longer seven 3D layers in the tree the rocket's frames update
     (with them there, phone x4 rocket phases read 7-9 frames over 50 ms
     against 1-3). !important because the controller writes the ring's
     transform inline; nearer than a screen, that inline value is back in
     force before the section shows. */
  .anime-work:global(.is-far) .anime-work__tunnel {
    display: none;
  }

  .anime-work:global(.is-far) .anime-work__cards {
    transform: none !important;
    transform-style: flat;
    will-change: auto;
  }

  .anime-work:global(.is-far) .anime-work__slot {
    transform: none;
  }

  .anime-work__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
    /* The tunnel's dot grid, static. */
    background-image: radial-gradient(circle, rgba(255, 242, 237, 0.16) 1px, transparent 1.4px);
    background-size: 28px 28px;
    background-position: center;
  }

  /* --- Act 1 and 2: the letters ------------------------------------------ */

  .anime-work__tunnel {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: repeat(4, 1fr);
    align-items: center;
    padding: 6svh 0;
    perspective: 1100px;
    pointer-events: none;
  }

  .anime-work__tunnel {
    /* The ring's radius, set by the controller once per resize so the
       stylesheet and the turn it writes agree; this is the fallback. */
    --radius: 420px;
  }

  .anime-work__ring {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    /* The ring's axis stands in front of the screen by its radius, the way
       the hero's wheel does: the far side faces the viewer, the middle copy
       sits on the screen at its own size and the copies to either side come
       forward and grow toward the edges — the inside of the old tunnel. The
       controller writes this whole transform, adding the turn. */
    transform: translateZ(var(--radius));
    will-change: transform;
  }

  .anime-work__letter {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1em;
    margin: -0.5em 0 0 -0.5em;
    font: 400 clamp(64px, 19svh, 190px) / 1 font-family(bigger);
    text-align: center;
    color: #fff2ed;
    /* Round the ring: each copy turned to its place and set back from the
       axis by the radius, facing it; the copy at i = 0 is the middle one. */
    transform: rotateY(calc(var(--i) * 360deg / var(--n))) translateZ(calc(-1 * var(--radius)));
    backface-visibility: hidden;
    /* Every letter starts hidden; the controller brings the front copies in
       first, then the rest, writing each one's own opacity. */
    opacity: 0;
  }

  .anime-work__veil {
    position: absolute;
    inset: 0;
    background: color(space);
    opacity: 0;
    pointer-events: none;
  }

  /* --- Act 3: the cards --------------------------------------------------- */

  .anime-work__carousel {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    perspective: 1600px;
    /* Transparent and off the pointer until the third act; the controller
       fades it in. Still focusable, so a keyboard can reach every card. */
    opacity: 0;
    pointer-events: none;
  }

  .anime-work__cards {
    --card: clamp(260px, 25vw, 360px);
    position: relative;
    width: var(--card);
    height: calc(var(--card) * 1.42);
    margin: 0;
    padding: 0;
    list-style: none;
    transform-style: preserve-3d;
    /* The ring's radius, the cards' half-width over tan(pi / n) widened by a
       gap, is set by the controller once per resize; this is the fallback.
       Pulled back by it, so the front card sits at exactly its own size; the
       controller writes this whole transform, adding the turn. */
    --ring-radius: 520px;
    transform: translateZ(calc(-1 * var(--ring-radius)));
    will-change: transform;
  }

  .anime-work__slot {
    position: absolute;
    inset: 0;
    transform: rotateY(calc(var(--i) * 360deg / var(--n))) translateZ(var(--ring-radius));
    backface-visibility: hidden;
  }

  .anime-work__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid color(work-border);
    border-radius: 18px;
    background: color(work-surface);
    color: color(work-text);
    text-decoration: none;
    /* A mouse drag turns the ring; the browser's own link and image drag
       would cancel it. */
    -webkit-user-drag: none;
    user-select: none;
    /* A hairline and a lighter top edge rather than a drop shadow: seven
       turning layers with a 60px blur each were most of this section's
       compositing cost on a software rasteriser. */
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition: border-color 200ms ease;

    &:hover,
    &:focus-visible {
      border-color: color(accent);
    }

    &:focus-visible {
      outline: 2px solid color(accent);
      outline-offset: 4px;
    }
  }

  .anime-work__media {
    display: block;
    flex: 0 0 52%;
    overflow: hidden;
    background: #16161a;

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .anime-work__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.1rem 1.1rem;
  }

  .anime-work__meta {
    display: flex;
    justify-content: space-between;
    font: 400 0.6875rem / 1 font-family(fraktion);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color(work-muted);
  }

  .anime-work__kind {
    padding: 0.3em 0.6em;
    border: 1px solid color(work-border);
    border-radius: 999px;
  }

  .anime-work__title {
    margin-top: 0.35rem;
    font: 400 clamp(1.9rem, 2.6vw, 2.5rem) / 0.95 font-family(bigger);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #fff;
  }

  .anime-work__role {
    font: 400 0.875rem / 1.35 font-family(geist);
    color: color(work-text);
  }

  .anime-work__when {
    font: 400 0.6875rem / 1.4 font-family(fraktion);
    letter-spacing: 0.06em;
    color: color(work-muted);
  }

  .anime-work__result {
    font: 400 0.75rem / 1.3 font-family(fraktion);
    letter-spacing: 0.04em;
    color: #ffd9a8;
  }

  .anime-work__open {
    margin-top: auto;
    font: 700 0.6875rem / 1 font-family(fraktion);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color(accent);
  }

  .anime-work__hint {
    position: absolute;
    left: 50%;
    bottom: 4svh;
    margin: 0;
    transform: translateX(-50%);
    font: 400 0.6875rem / 1 font-family(fraktion);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color(work-muted);
    opacity: 0;
    transition: opacity 300ms ease;

    &:global(.is-on) {
      opacity: 1;
    }
  }

  @media (max-width: 639.98px) {
    .anime-work__cards {
      --card: min(72vw, 290px);
    }

    /* A phone's ring is small: every other copy, and smaller letters, or
       the band turns into a fence. */
    .anime-work__letter {
      font-size: clamp(56px, 12svh, 120px);
    }

    .anime-work__letter:nth-child(3n + 2) {
      display: none;
    }
  }

  @media (pointer: coarse) {
    .anime-work__drag {
      display: none;
    }
  }

  /* Stillness, not absence: no holding, no turning. The word is set once and
     the cards sit in a row the hand or the keyboard scrolls sideways. */
  @media (prefers-reduced-motion: reduce) {
    .anime-work {
      height: auto;
      padding: 12svh 0 10svh;
    }

    .anime-work__stage {
      position: static;
      height: auto;
      background: none;
    }

    .anime-work__tunnel {
      position: static;
      display: flex;
      justify-content: center;
      gap: 0.1em;
      padding: 0 0 6svh;
      perspective: none;
    }

    .anime-work__ring {
      height: auto;
      opacity: 1;
      will-change: auto;
      transform-style: flat;
    }

    .anime-work__letter {
      position: static;
      display: block;
      margin: 0;
      transform: none;
      opacity: 1;
      font-size: clamp(64px, 14vw, 180px);
    }

    .anime-work__veil {
      display: none;
    }

    .anime-work__letter:not(.is-front) {
      display: none;
    }

    .anime-work__carousel {
      position: static;
      display: block;
      opacity: 1;
      pointer-events: auto;
      perspective: none;
    }

    .anime-work__cards {
      display: flex;
      gap: 1rem;
      width: auto;
      height: auto;
      padding: 0 clamp(1rem, 4vw, 3rem) 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      transform: none;
      transform-style: flat;
      will-change: auto;
    }

    .anime-work__slot {
      position: static;
      flex: 0 0 var(--card);
      height: calc(var(--card) * 1.42);
      transform: none;
      scroll-snap-align: center;
    }

    .anime-work__hint {
      display: none;
    }
  }
</style>
