---
import BentoCard from "./BentoCard.astro";

const cards = [
  {
    variant: "large" as const,
    title: "hardware, not just screens",
    text: "Most of what I build starts as a physical thing: a haptic glove wired to a Raspberry Pi, 3D-printed glasses with an OLED on the frame, printed rocket airframes, cameras calibrated into a LabVIEW rig. I design the board, print the parts, write the firmware and then build the interface on top of it.",
  },
  {
    variant: "medium" as const,
    title: "24 hours, twice",
    text: "TouchPoint took 2nd overall and won the Google track at QuackHacks 3.0. SPOOT placed 3rd in the Google track at BeaverHacks 2026. Both were built from nothing inside a day, by teams of two and three.",
  },
  {
    variant: "wide" as const,
    title: "measured, not asserted",
    text: "This site has a performance harness that runs against the production build in three engines and reports frame timing, long tasks, forced reflows and listener growth. It exists because four animation systems on one page competed for the same frame budget, and no amount of reasoning found it — the profile did. Every fix in the repository carries its before and after numbers, and the hypotheses that failed are written down so nobody re-runs them.",
  },
  {
    variant: "small" as const,
    title: "research, written up",
    text: "URSA Engage funded me to answer one question for Oregon State's remote chemistry labs: which camera can hold a readable feed inside LabVIEW. Four cameras, RGB intensity histograms, one recommendation the lab now builds against.",
  },
  {
    variant: "small" as const,
    title: "students, taught",
    text: "I ran a rocket club at a faculty of science and technology, where the job was less about rockets than about a loop a beginner could join: design a part, print it, find out why it failed, do it again.",
  },
];
---

<section class="bento-section">
  <div class="bento-separator">
    <div class="bento-separator__line"></div>
  </div>

  <div class="bento-header">
    <h2 class="bento-header__title">Why work with me?</h2>
  </div>

  <div class="bento-container">
    <div class="bento-grid">
      {cards.map((card) => (
        <BentoCard variant={card.variant} title={card.title} text={card.text} />
      ))}
    </div>

    <div class="bento-footer">
      <h2 class="bento-footer__title">
        Built for performance. Designed for flexibility.
      </h2>
      <p class="bento-footer__text">
        I build beautiful, high-performing websites with lightning speed. Every
        component is thoughtfully designed to be flexible, reusable, and
        accessible.
      </p>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/helpers/fonts" as *;
  @use "../styles/helpers/responsive" as *;

  .bento-section {
    position: relative;
    background: #fff2ed;
    padding: 0;
    min-height: 100vh;
    z-index: 20;
    overflow: hidden;
  }

  .bento-separator {
    padding: clamp(4rem, 10vh, 12rem) 0 clamp(2rem, 5vh, 6rem);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .bento-separator__line {
    width: min(90%, 600px);
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(0, 0, 0, 0.15) 20%,
      rgba(0, 0, 0, 0.3) 50%,
      rgba(0, 0, 0, 0.15) 80%,
      transparent
    );
  }

  .bento-header {
    text-align: center;
    padding: 0 clamp(1.5rem, 4vw, 3rem) clamp(3rem, 6vh, 4rem);
  }

  .bento-header__title {
    font-family: font-family(editorial);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 400;
    line-height: 1.1;
    color: #000;
    margin: 0;
    text-transform: lowercase;
  }

  .bento-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem) clamp(2rem, 4vh, 4rem);
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: auto;
    gap: 1rem;
    margin-bottom: clamp(3rem, 5vh, 5rem);

    @media (max-width: 1024px) {
      grid-template-columns: repeat(4, 1fr);
    }

    @media (max-width: 640px) {
      grid-template-columns: 1fr;
    }
  }

  :global(.bento-card) {
    position: relative;
    border: 1px dashed rgba(255, 255, 255, 0.3);
    border-radius: 0.75rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: #000;
    min-height: 200px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;

    @media (max-width: 576px) {
      min-height: 160px;
      padding: 1.25rem;
    }
  }

  :global(.bento-card:hover) {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  :global(.bento-card--large) {
    grid-column: span 3;
    grid-row: span 2;

    @media (max-width: 1024px) { grid-column: span 4; grid-row: span 2; }
    @media (max-width: 640px)  { grid-column: span 1; grid-row: span 1; }
  }

  :global(.bento-card--medium) {
    grid-column: span 2;
    grid-row: span 2;

    @media (max-width: 1024px) { grid-column: span 4; grid-row: span 1; }
    @media (max-width: 640px)  { grid-column: span 1; grid-row: span 1; }
  }

  :global(.bento-card--wide) {
    grid-column: span 4;
    grid-row: span 1;

    @media (max-width: 1024px) { grid-column: span 4; grid-row: span 1; }
    @media (max-width: 640px)  { grid-column: span 1; grid-row: span 1; }
  }

  :global(.bento-card--small) {
    grid-column: span 2;
    grid-row: span 1;

    @media (max-width: 1024px) { grid-column: span 2; grid-row: span 1; }
    @media (max-width: 640px)  { grid-column: span 1; grid-row: span 1; }
  }

  :global(.corner-plus) {
    position: absolute;
    width: 24px;
    height: 24px;
    color: #fff;
    display: flex;
  }

  :global(.corner-plus--tl) { top: -12px; left: -12px; }
  :global(.corner-plus--tr) { top: -12px; right: -12px; }
  :global(.corner-plus--bl) { bottom: -12px; left: -12px; }
  :global(.corner-plus--br) { bottom: -12px; right: -12px; }

  :global(.bento-card__content) {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(.bento-card__title) {
    font-family: font-family(editorial);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    font-weight: 400;
    line-height: 1.2;
    color: #fff;
    margin: 0;
    text-transform: lowercase;
  }

  :global(.bento-card__text) {
    font-family: font-family(fraktion);
    font-size: clamp(0.875rem, 1vw, 1rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }

  .bento-footer {
    max-width: 40rem;
    margin-left: auto;
    text-align: right;
    padding: 0 clamp(1rem, 2vw, 2rem);

    @media (max-width: 768px) {
      text-align: left;
      margin: 0;
    }
  }

  .bento-footer__title {
    font-family: font-family(editorial);
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 400;
    line-height: 1.15;
    color: #000;
    margin: 0 0 1.5rem 0;
    text-transform: lowercase;
  }

  .bento-footer__text {
    font-family: font-family(fraktion);
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.7);
    margin: 0;
  }
</style>
