---
const { className = "" } = Astro.props;
---

<div class:list={["dotted-surface", className]} data-dotted-surface></div>

<script>
  import type * as THREEType from "three";

  // Three.js is imported at runtime rather than at parse time. The whole
  // library rides on WebGLRenderer — 491 KB raw, 123 KB gzipped, and named
  // imports do not shrink it — and this field is decoration behind the hero
  // type. Loading it with the page put it on the critical path ahead of
  // everything the visitor actually reads. It now arrives once the browser is
  // idle, and the hero is complete without it.
  let THREE: typeof THREEType;

  /**
   * True when this browser will actually hand out a WebGL context. Covers an
   * old machine, a blocklisted driver, WebGL switched off in settings, and a
   * headless run. The probe canvas is thrown away immediately.
   */
  function hasWebGL(): boolean {
    try {
      const canvas = document.createElement("canvas");
      const gl =
        canvas.getContext("webgl2") ||
        canvas.getContext("webgl") ||
        canvas.getContext("experimental-webgl");
      if (!gl) return false;
      const lose = (gl as WebGLRenderingContext).getExtension("WEBGL_lose_context");
      lose?.loseContext();
      return true;
    } catch {
      return false;
    }
  }

  const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);

  class DottedSurfaceAnimation {
    container: HTMLElement;
    scene!: THREEType.Scene;
    camera!: THREEType.PerspectiveCamera;
    renderer!: THREEType.WebGLRenderer;
    destroyed = false;
    contextLost = false;
    /** False when WebGL is unavailable; every entry point then does nothing. */
    supported = false;
    points!: THREEType.Points;
    geometry!: THREEType.BufferGeometry;
    material!: THREEType.PointsMaterial;
    animationId: number;
    count: number;
    frameCount: number;
    paused = false;

    readonly SEPARATION = 150;
    readonly AMOUNTX = 40;
    readonly AMOUNTY = 60;

    constructor(container: HTMLElement) {
      this.container = container;
      this.count = 0;
      this.animationId = 0;
      this.frameCount = 0;

      this.supported = this.initScene();
      if (!this.supported) return;

      this.createParticles();
      this.bindEvents();
      this.animate();
    }

    /**
     * Returns false when this browser cannot give us a WebGL context — an old
     * machine, a blocklisted driver, WebGL switched off, or a headless run.
     * Three.js logs its own console error and throws in that case; the hero
     * has its type and its background without us, so the honest response is
     * to leave the field out rather than to fail loudly.
     */
    initScene(): boolean {
      this.scene = new THREE.Scene();

      this.camera = new THREE.PerspectiveCamera(
        60,
        window.innerWidth / window.innerHeight,
        1,
        10000,
      );
      this.camera.position.set(0, 355, 1220);

      // Safari gets a lighter renderer setup to keep the background smooth.
      // Ask for a context ourselves first. Three.js logs its own console
      // error before it throws, so catching the throw is not enough to keep
      // the console clean on a machine without WebGL.
      if (!hasWebGL()) return false;

      try {
        this.renderer = new THREE.WebGLRenderer({
          alpha: true,
          antialias: !isSafari, // Antialias triggers extra GPU passes in Safari
          powerPreference: isSafari ? "default" : "high-performance",
        });
      } catch {
        return false;
      }
      // Cap pixel ratio at 1 on Safari to halve GPU fill-rate
      this.renderer.setPixelRatio(
        Math.min(window.devicePixelRatio, isSafari ? 1 : 2),
      );
      this.renderer.setSize(window.innerWidth, window.innerHeight);
      this.renderer.setClearColor(0x000000, 0);

      this.container.appendChild(this.renderer.domElement);
      this.watchContext();
      return true;
    }

    createParticles() {
      const positions: number[] = [];
      const colors: number[] = [];

      for (let ix = 0; ix < this.AMOUNTX; ix++) {
        for (let iy = 0; iy < this.AMOUNTY; iy++) {
          const x = ix * this.SEPARATION - (this.AMOUNTX * this.SEPARATION) / 2;
          const y = 0;
          const z = iy * this.SEPARATION - (this.AMOUNTY * this.SEPARATION) / 2;

          positions.push(x, y, z);

          // Pure white for maximum visibility
          colors.push(255, 255, 255);
        }
      }

      this.geometry = new THREE.BufferGeometry();
      this.geometry.setAttribute(
        "position",
        new THREE.Float32BufferAttribute(positions, 3),
      );
      this.geometry.setAttribute(
        "color",
        new THREE.Float32BufferAttribute(colors, 3),
      );

      this.material = new THREE.PointsMaterial({
        size: 12,
        vertexColors: true,
        transparent: true,
        opacity: 0.3,
        sizeAttenuation: true,
      });

      this.points = new THREE.Points(this.geometry, this.material);
      this.scene.add(this.points);
    }

    pause() {
      if (!this.supported || this.paused) return;
      this.paused = true;
      cancelAnimationFrame(this.animationId);
    }

    resume() {
      if (!this.supported || this.destroyed || this.contextLost) return;
      if (!this.paused) return;
      this.paused = false;
      this.animate();
    }

    /**
     * A frozen page can have its GPU context reclaimed — iOS Safari does this
     * routinely — and rendering into a lost context produces a warning every
     * frame and no pixels. preventDefault on the loss is what makes a restore
     * possible at all; until it arrives there is nothing to draw.
     */
    watchContext() {
      const canvas = this.renderer.domElement;
      canvas.addEventListener("webglcontextlost", this.onContextLost);
      canvas.addEventListener("webglcontextrestored", this.onContextRestored);
    }

    onContextLost = (event: Event) => {
      event.preventDefault();
      this.contextLost = true;
      this.pause();
    };

    onContextRestored = () => {
      this.contextLost = false;
      // Only if the hero is actually on screen. A restore that arrives while
      // the visitor is down in the Work section would otherwise start a
      // full-viewport render loop nobody can see, and the observer will not
      // fire again to stop it — its intersection state never changed.
      if (!document.hidden && this.isOnScreen()) this.resume();
    };

    /** The one on-screen test, so the three callers cannot drift apart. */
    isOnScreen() {
      const rect = this.container.getBoundingClientRect();
      return rect.bottom > 0 && rect.top < window.innerHeight;
    }

    animate = () => {
      if (this.paused) return;
      this.animationId = requestAnimationFrame(this.animate);
      this.frameCount++;

      // Throttle to ~30fps on Safari to reduce GPU pressure
      if (isSafari && this.frameCount % 2 !== 0) return;

      const positionAttribute = this.geometry.attributes.position;
      const positions = positionAttribute.array as Float32Array;

      let i = 0;
      for (let ix = 0; ix < this.AMOUNTX; ix++) {
        for (let iy = 0; iy < this.AMOUNTY; iy++) {
          const index = i * 3;

          positions[index + 1] =
            Math.sin((ix + this.count) * 0.3) * 50 +
            Math.sin((iy + this.count) * 0.5) * 50;

          i++;
        }
      }

      positionAttribute.needsUpdate = true;
      this.renderer.render(this.scene, this.camera);
      this.count += 0.03;
    };

    handleResize = () => {
      this.camera.aspect = window.innerWidth / window.innerHeight;
      this.camera.updateProjectionMatrix();
      this.renderer.setSize(window.innerWidth, window.innerHeight);
    };

    bindEvents() {
      window.addEventListener("resize", this.handleResize, { passive: true });
    }

    destroy() {
      // Nothing was ever created when WebGL is unavailable, so there is
      // nothing to tear down and no renderer to dispose.
      if (!this.supported || this.destroyed) return;
      // The pagehide listener is no longer once-only, because it now has to
      // tell a freeze from an unload. A second unload — a cache eviction
      // followed by a real one — would otherwise re-enter here, dispose what
      // is already disposed and throw NotFoundError out of removeChild,
      // aborting the rest of the teardown.
      this.destroyed = true;
      this.paused = true;

      window.removeEventListener("resize", this.handleResize);
      this.renderer.domElement.removeEventListener("webglcontextlost", this.onContextLost);
      this.renderer.domElement.removeEventListener("webglcontextrestored", this.onContextRestored);
      cancelAnimationFrame(this.animationId);

      this.scene.traverse((object: THREEType.Object3D) => {
        if (object instanceof THREE.Points) {
          object.geometry.dispose();
          if (Array.isArray(object.material)) {
            object.material.forEach((mat: THREEType.Material) => mat.dispose());
          } else {
            object.material.dispose();
          }
        }
      });

      this.renderer.dispose();

      if (this.container && this.renderer.domElement) {
        this.container.removeChild(this.renderer.domElement);
      }
    }
  }

  const mount = async () => {
    const container = document.querySelector(
      "[data-dotted-surface]",
    ) as HTMLElement;
    if (!container) {
      return;
    }

    // Nothing below can run without a context, and asking first means a
    // machine without WebGL never downloads the library at all.
    if (!hasWebGL()) return;

    try {
      THREE = await import("three");
    } catch {
      return;
    }

    const animation = new DottedSurfaceAnimation(container);

    // Render only while the hero is on screen and the tab is visible.
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !document.hidden) animation.resume();
        else animation.pause();
      });
    });
    observer.observe(container);

    const onVisibilityChange = () => {
      if (document.hidden) animation.pause();
      else if (animation.isOnScreen()) animation.resume();
    };
    document.addEventListener("visibilitychange", onVisibilityChange);

    const onPageShow = (event: Event) => {
      if (!(event as PageTransitionEvent).persisted) return;
      if (!document.hidden && animation.isOnScreen()) animation.resume();
    };
    window.addEventListener("pageshow", onPageShow);

    // Everything this closure attached, taken back off in one place, so the
    // two callers below cannot get it half right.
    const teardown = () => {
      document.removeEventListener("visibilitychange", onVisibilityChange);
      window.removeEventListener("pageshow", onPageShow);
      window.removeEventListener("pagehide", onPageHide);
      observer.disconnect();
      animation.destroy();
    };

    // pagehide fires both when the page is really going away and when it is
    // being frozen into the back/forward cache. Tearing down on both meant a
    // visitor who opened a project and pressed Back — the exact journey the
    // dive is built for, and the default on iOS Safari — came back to a hero
    // with no field and nothing left to rebuild it. Destroy only on a real
    // unload; a frozen page runs no rAF anyway, so pausing is enough.
    function onPageHide(event: Event) {
      if ((event as PageTransitionEvent).persisted) {
        animation.pause();
        return;
      }
      teardown();
    }
    window.addEventListener("pagehide", onPageHide);

    return teardown;
  };

  // Mount once the page has settled: the field is decoration, and fetching
  // half a megabyte of library before the hero has painted is the wrong order.
  if (typeof window !== "undefined") {
    const start = () => {
      if ("requestIdleCallback" in window) {
        (
          window as Window & {
            requestIdleCallback: (cb: () => void, o?: { timeout: number }) => number;
          }
        ).requestIdleCallback(() => void mount(), { timeout: 2500 });
      } else {
        setTimeout(() => void mount(), 400);
      }
    };

    if (document.readyState === "complete") start();
    else window.addEventListener("load", start, { once: true });
  }
</script>

<style lang="scss">
  .dotted-surface {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;

    :global(canvas) {
      display: block;
      width: 100%;
      height: 100%;
    }
  }
</style>
