---
import AWork from "./AWork.astro";
import { buildWorksList } from "../data/works";

const works = buildWorksList();
---

<section id="work" class="s-work" data-intersect>
  <div class="s__outer">
    <div class="s__inner js-container">
      <h2 class="s__title">
        <span class="s__title__inner js-title">
          <span class="s__title__letter js-letter">W</span>
          <span class="s__title__letter js-letter">O</span>
          <span class="s__title__letter js-letter">R</span>
          <span class="s__title__letter js-letter">K</span>
        </span>
      </h2>

      <div class="s__scene js-scene">
        {
          works.map((work, index) => (
            <AWork
              cssClass="s__scene__work s__scene__work--video js-work"
              caption={work.caption}
              site={work.site}
              index={String(index).padStart(4, "0")}
              total={String(works.length).padStart(2, "0")}
            />
          ))
        }
      </div><!-- .s__scene -->

      <canvas class="s__canvas js-canvas"></canvas>
      <div class="s__mask-outer">
        <div class="s__mask js-mask">
          <svg class="s__mask__svg js-mask-svg">
            <defs>
              <clipPath id="s-lines-clip">
                <path class="js-lines-clip-shape" clip-rule="evenodd" d=""
                ></path>
              </clipPath>
            </defs>
            <path class="s__mask__path-inner js-mask-path-inner" d=""></path>
            <path class="s__mask__path-outer js-mask-path-outer" d=""></path>
            <path
              class="s__mask__path-lines js-mask-path-lines"
              d=""
              clip-path="url(#s-lines-clip)"></path>
          </svg>
        </div><!-- .s__mask -->
      </div><!-- .s__mask-outer -->
    </div><!-- .s__inner -->

    <div class="s__ruler js-ruler"></div>
  </div><!-- .s__outer -->
</section>

<script>
  import { initWorkSection } from "../utils/WorkSection";
  initWorkSection();
</script>

<style lang="scss">
  .s-work {
    --height: 100vh;

    position: relative;
    z-index: 2;

    height: var(--height);

    background: #000000;

    opacity: 0;
    transition: opacity 0.3s ease;

    &.is-mask-ready {
      opacity: 1;
    }

    &:before {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 2;

      width: 100%;
      height: 1px;

      background: color(secondary);

      content: "";
    }

    .s__mask-outer {
      position: absolute;
      inset: 0;
      z-index: 100;

      width: 100%;
      height: 100%;

      pointer-events: none;
      will-change: opacity, transform;
    }

    .s__mask {
      position: absolute;
      top: 0;
      left: 0;

      width: 100%;
      height: 100%;

      &__svg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
      }

      &__path-outer {
        fill: none;
        fill-rule: evenodd;
        stroke: none;
      }

      &__path-inner {
        fill: none;
        fill-rule: evenodd;
        stroke: none;

        /* transform is written inline from WorkSection.tick() */
        will-change: transform;
      }

      &__path-lines {
        display: none;
        fill: none;
        stroke: color(secondary);
        stroke-width: 1px;
      }
    }

    .s__outer {
      position: relative;

      height: var(--height);
    }

    .s__inner {
      @include flex(column, center, center);

      position: relative;
      top: 0;
      left: 0;

      width: 100%;
      height: 100vh;
      height: 100lvh;

      background: #000000;
      color: color(primary);
    }

    .s__ruler {
      --width: min(16.6667%, 19.625rem);

      position: absolute;
      top: 10vh;
      left: calc(50% - var(--width) / 2);

      width: var(--width);
      height: 80vh;

      pointer-events: none;

      @include mq(tablet) {
        --width: 33.3333%;
      }

      @include mq(phone) {
        --width: 50%;
      }
    }

    .s__title,
    .s__scene {
      font: 700 min(18.75rem, 25vh) / 1 font-family(bigger);
      font-size: min(18.75rem, 25lvh);
      text-align: center;
      text-transform: uppercase;
    }

    .s__title__inner,
    :global(.s__scene__letter) {
      line-height: 0.85;
    }

    .s__title {
      width: 0.7em;

      opacity: 0;
      word-break: break-all;

      &__inner {
        @include flex(column, center, center);

        margin: 0;
      }
    }

    .s__scene {
      --shadow: #{color(shadow)};
      --progress: 0.5;
      --state: 0;

      position: absolute;
      top: 0;
      left: 0;
      z-index: 2;

      width: 100%;
      height: 100%;

      perspective: 40rem;

      will-change: transform;

      :global(.s__scene__letter) {
        position: absolute;
        top: 0;
        left: 0;

        display: block;

        pointer-events: none;
        will-change: transform;
      }

      /* Real child instead of ::before — transform/opacity are written
         inline from WorkSection.moveLetters(), which takes the cheap
         recalc path instead of re-resolving var()/calc() chains. */
      :global(.s__scene__letter__shadow) {
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        color: color(shadow);
        opacity: 0;

        will-change: opacity, transform;
      }

      :global(.s__scene__work) {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 2;

        transform: rotateY(calc(var(--progress) * -20deg))
          translate3d(
            calc(var(--progress) * (50vw + 100%) - 50%),
            calc(var(--y) * 50% - 50%),
            calc(var(--progress) * var(--progress) * -5rem)
          )
          scale(var(--size));

        will-change: transform;

        @include mq(tablet) {
          transform: rotateY(calc(var(--progress) * -20deg))
            translate3d(
              calc(var(--progress) * (50vw + 100%) - 50%),
              calc(var(--y) * 50% - 50%),
              calc(var(--progress) * var(--progress) * -5rem)
            );
        }

        @include mq(phone) {
          transform: rotateY(calc(var(--progress) * -20deg))
            translate3d(
              calc(var(--progress) * (50vw + 100%) - 50%),
              calc(var(--y) * 100% - 50%),
              calc(var(--progress) * var(--progress) * -5rem)
            );
        }
      }
    }

    .s__canvas {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 1;

      width: 100%;
      height: 100%;

      /* transform is written inline from WorkSection.tick(); phone stays
         static there (iOS jitter) */
    }
  }
</style>
