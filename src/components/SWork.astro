---
import AWork from "./AWork.astro";
import { works, type ProjectInfo } from "../data/works";

/**
 * WORK: the letter tunnel. /tunnel/ mounts it with works.ts; the anime home
 * mounts it with `home` and its own list (data/workCards.ts) — the owner,
 * 2026-10-03: WORK as it was on Vercel, entered from the star field.
 *
 * On the home the section starts one screen early, over the star field's
 * last screen, and shows nothing until the field hands its letters over
 * (`is-on`, Space.ts); the container sticks with CSS instead of a
 * ScrollTrigger pin (no one-frame lag on iOS), and the section's height is
 * static CSS, so nothing on the page is re-measured after load. The tunnel's
 * colours come from `theme-contrasted` on the section, because the anime
 * theme's primary is near-black.
 */
interface Props {
  items?: readonly ProjectInfo[];
  home?: boolean;
}
const { items = works, home = false } = Astro.props;
---

<section
  id="work"
  class:list={["s-work", { "s-work--home theme-contrasted is-far": home }]}
  data-intersect={home ? undefined : ""}
  style={home ? `--steps:${items.length}` : undefined}
>
  <div class="s__outer">
    <div class="s__inner js-container">
      <h2 class="s__title">
        <span class="s__title__inner js-title">
          <span class="s__title__letter js-letter">W</span>
          <span class="s__title__letter js-letter">O</span>
          <span class="s__title__letter js-letter">R</span>
          <span class="s__title__letter js-letter">K</span>
        </span>
      </h2>

      {/* The cards live inside a scroll-driven scene whose contents are skipped
          (content-visibility) until the tunnel opens, so they are not a reliable
          tab stop. This list is the keyboard and screen-reader route to the same
          projects, and it is always present. */}
      <nav class="s__index js-work-index" aria-label="Projects">
        <ul>
          {
            items.map((work) => (
              <li>
                <a href={work.site}>
                  {work.title} — {work.blurb}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="s__scene js-scene">
        {
          items.map((work) => (
            <AWork
              cssClass="s__scene__work s__scene__work--video js-work"
              caption={work.title}
              site={work.site}
              blurb={work.blurb}
              size={work.size}
              palette={work.palette}
              poster={work.poster}
              cover={"cover" in work ? work.cover : undefined}
            />
          ))
        }
      </div><!-- .s__scene -->

      {/* Home only: the star field the wall dissolves into, and the dust
          it dissolves as (WorkDust.ts). */}
      {home && <div class="s__stars js-stars" aria-hidden="true"></div>}
      <canvas class="s__canvas js-canvas"></canvas>
      {home && <canvas class="s__dust js-dust" width="0" height="0" aria-hidden="true"></canvas>}
      <div class="s__mask-outer">
        <div class="s__mask js-mask">
          <svg class="s__mask__svg js-mask-svg">
            <defs>
              <clipPath id="s-lines-clip">
                <path class="js-lines-clip-shape" clip-rule="evenodd" d=""
                ></path>
              </clipPath>
            </defs>
            <path class="s__mask__path-inner js-mask-path-inner" d=""></path>
            <path class="s__mask__path-outer js-mask-path-outer" d=""></path>
            <path
              class="s__mask__path-lines js-mask-path-lines"
              d=""
              clip-path="url(#s-lines-clip)"></path>
          </svg>
        </div><!-- .s__mask -->
      </div><!-- .s__mask-outer -->
    </div><!-- .s__inner -->

    <div class="s__ruler js-ruler"></div>
  </div><!-- .s__outer -->
</section>

<script>
  import { initWorkSection } from "../utils/WorkSection";
  import { initDiveTransition } from "../utils/DiveTransition";

  const section = initWorkSection();
  initDiveTransition(section);
</script>

<style lang="scss">
  .s-work {
    --height: 100vh;

    position: relative;
    z-index: 2;

    height: var(--height);

    background: #000000;

    opacity: 0;
    transition: opacity 0.3s ease;

    &.is-mask-ready {
      opacity: 1;
    }

    &:before {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 2;

      width: 100%;
      height: 1px;

      background: color(secondary);

      content: "";
    }

    .s__mask-outer {
      position: absolute;
      inset: 0;
      z-index: 100;

      width: 100%;
      height: 100%;

      pointer-events: none;
      will-change: opacity, transform;
    }

    .s__mask {
      position: absolute;
      top: 0;
      left: 0;

      width: 100%;
      height: 100%;

      &__svg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
      }

      &__path-outer {
        fill: none;
        fill-rule: evenodd;
        stroke: none;
      }

      &__path-inner {
        fill: none;
        fill-rule: evenodd;
        stroke: none;

        /* transform is written inline from WorkSection.tick() */
        will-change: transform;
      }

      &__path-lines {
        display: none;
        fill: none;
        stroke: color(secondary);
        stroke-width: 1px;
      }
    }

    .s__outer {
      position: relative;

      height: var(--height);
    }

    .s__inner {
      @include flex(column, center, center);

      position: relative;
      top: 0;
      left: 0;

      width: 100%;
      /* svh, not lvh: this is the pinned container. `lvh` is the viewport with
         the iOS toolbar *retracted*, so while the toolbar is showing the pin is
         taller than the visible area and its bottom is clipped. `dvh` (and a px
         value from innerHeight) would fit but track the toolbar animation, which
         resizes the pin mid-scroll and staleness-checks ScrollTrigger's cached
         geometry. `svh` is the only one that both fits and never changes.
         Matches HeroHome's `100vh` -> `100svh`. Desktop is unaffected: vh, svh,
         lvh and dvh are all equal where there is no dynamic toolbar. */
      height: 100vh;
      height: 100svh;

      background: #000000;
      color: color(primary);
    }

    .s__ruler {
      --width: min(16.6667%, 19.625rem);

      position: absolute;
      top: 10vh;
      left: calc(50% - var(--width) / 2);

      width: var(--width);
      height: 80vh;

      pointer-events: none;

      @include mq(tablet) {
        --width: 33.3333%;
      }

      @include mq(phone) {
        --width: 50%;
      }
    }

    .s__title,
    .s__scene {
      /* Same basis as the pinned container above — type sized from the large
         viewport inside a small-viewport box would overflow it on iOS and
         re-lay-out the whole letter tunnel every time the toolbar moved. */
      font: 700 min(18.75rem, 25vh) / 1 font-family(bigger);
      font-size: min(18.75rem, 25svh);
      text-align: center;
      text-transform: uppercase;
    }

    .s__title__inner,
    :global(.s__scene__letter) {
      line-height: 0.85;
    }

    .s__title {
      width: 0.7em;

      opacity: 0;
      word-break: break-all;

      &__inner {
        @include flex(column, center, center);

        margin: 0;
      }
    }

    .s__scene {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 2;

      width: 100%;
      height: 100%;

      perspective: 40rem;

      will-change: transform;

      :global(.s__scene__letter) {
        position: absolute;
        top: 0;
        left: 0;

        display: block;

        pointer-events: none;
        will-change: transform;
      }

      /* Real child instead of ::before — transform/opacity are written
         inline from WorkSection.moveLetters(), which takes the cheap
         recalc path instead of re-resolving var()/calc() chains. */
      :global(.s__scene__letter__shadow) {
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        color: color(shadow);
        opacity: 0;

        will-change: opacity, transform;
      }

      :global(.s__scene__work) {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 2;

        transform: rotateY(calc(var(--progress) * -20deg))
          translate3d(
            calc(var(--progress) * (50vw + 100%) - 50%),
            calc(-50% + var(--y) * 10vh),
            calc(var(--progress) * var(--progress) * -5rem)
          );

        will-change: transform;

        @include mq(tablet) {
          transform: rotateY(calc(var(--progress) * -20deg))
            translate3d(
              calc(var(--progress) * (50vw + 100%) - 50%),
              calc(-50% + var(--y) * 9vh),
              calc(var(--progress) * var(--progress) * -5rem)
            );
        }

        @include mq(phone) {
          transform: rotateY(calc(var(--progress) * -20deg))
            translate3d(
              calc(var(--progress) * (50vw + 100%) - 50%),
              calc(-50% + var(--y) * 7svh),
              calc(var(--progress) * var(--progress) * -5rem)
            );
        }
      }
    }

    .s__canvas {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 1;

      width: 100%;
      height: 100%;

      /* transform is written inline from WorkSection.tick(); phone stays
         static there (iOS jitter) */
    }
  }

  /* --- The anime home -------------------------------------------------- */

  /* One screen up, over the star field's last screen; that screen paints
     nothing until the hand-off, and below it the section is space black.
     The height is the tunnel's own sum, in svh, as static CSS: the 100svh
     container, a 140svh intro, one step per project (80svh, 72 on a phone),
     a 60svh hold, then 100svh where the wall dissolves into stars.
     WorkSection keeps the same numbers. */
  .s-work.s-work--home {
    --step: 80;
    margin-top: -100svh;
    height: calc((100 + 140 + var(--steps) * var(--step) + 60 + 100) * 1svh);
    background: linear-gradient(to bottom, transparent 0 100svh, color(space) 100svh);
    opacity: 1;
    transition: none;

    @media (max-width: 575.98px) {
      --step: 72;
    }

    &:before {
      display: none;
    }

    .s__outer {
      height: 100%;
    }

    /* Sticky, not pinned: the star field above is sticky too, and a pin goes
       fixed a frame late under iOS's native scroll. */
    .s__inner {
      position: sticky;
      top: 0;
      background: transparent;
    }

    /* Before the hand-off the star field draws these letters itself. */
    &:not(.is-on) :is(.s__scene, .s__canvas, .s__mask-outer) {
      visibility: hidden;
    }

    /* A screen away, the tunnel's layers leave the tree (invariant 11); the
       project index stays, it is the keyboard's route. */
    &.is-far :is(.s__scene, .s__canvas, .s__mask-outer, .s__dust) {
      display: none;
    }

    /* The descent's field (AnimeParadise.astro), faded in by WorkDust.ts as
       the last specks land on its stars. */
    .s__stars {
      position: absolute;
      inset: 0;
      z-index: 0;
      opacity: 0;
      pointer-events: none;
      @include star-tiles;
    }

    /* The grid is drawn once the points have gathered and then only moves:
       its own layer, one gap wider than the stage for the drift
       (WorkSection.drawGridHome). */
    .s__canvas {
      width: calc(100% + 24px);
      will-change: transform;
    }

    /* Its own layer (invariant 13): it redraws with the scroll's progress.
       Out of the tree outside the dissolve (WorkDust.update sets is-live)
       and whenever the section is far. */
    &:not(.is-far) .s__dust:global(.is-live) {
      display: block;
    }

    .s__dust {
      display: none;
      position: absolute;
      inset: 0;
      z-index: 3;
      width: 100%;
      height: 100%;
      pointer-events: none;
      will-change: transform;
    }

    /* On a phone the star field sits at z-index 3 over the flight's stage,
       and this section's first screen lies over its last one. */
    @media (max-width: 639.98px) {
      z-index: 4;
    }
  }

  /* No star field gathers under reduced motion (Space.ts does not run), so
     nothing hands the letters over: they are simply there. */
  @media (prefers-reduced-motion: reduce) {
    .s-work.s-work--home {
      margin-top: 0;
    }

    .s-work.s-work--home:not(.is-on) :is(.s__scene, .s__canvas, .s__mask-outer) {
      visibility: visible;
    }
  }

  /* Keyboard and screen-reader route to the projects. Visually hidden until a
     link inside it takes focus, so a sighted keyboard user sees what the ring
     is on instead of seven invisible stops. */
  .s__index {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 30;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;

    &:focus-within {
      width: auto;
      height: auto;
      margin: 0;
      padding: 1rem 1.25rem;
      overflow: visible;
      clip-path: none;
      white-space: normal;
      background: #000;
      color: #fff2ed;
      font: 400 0.8125rem / 1.6 var(--font-family-fraktion), monospace;
      letter-spacing: 0.06em;
    }

    ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
</style>
