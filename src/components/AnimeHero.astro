---
import { works } from "../data/works";

/**
 * The light hero: one huge headline bent along a shallow arc, a slow wheel of
 * project covers turning behind it, and a slot where the drawn figure will go.
 *
 * The reference draws all of this inside a single WebGL canvas. This does not,
 * deliberately. The headline is SVG text on a path — real glyphs, crisp at any
 * size, no font atlas to build and no shader to keep in budget — and the wheel
 * is CSS 3D, which is the same technique the letter tunnel in this repository
 * already uses. Same picture, a fraction of the cost, and the text stays text.
 *
 * The headline is the owner's name, split into HEADLINE_LEFT and
 * HEADLINE_RIGHT so each word can ride the arc from its own corner. It is the
 * name because that is the one thing on this page that needs no argument; a
 * discipline line would be a claim, and claims on this site come from the
 * fact list.
 */

/* The three pieces of copy on the first screen, each its own constant so a
   change of mind is a change of one line. */
const HEADLINE_LEFT = "JAKHANGIR";
const HEADLINE_RIGHT = "TYNSHIMOV";
const LINE_LEFT = "Computer Science, minoring in Physics";
const LINE_LEFT_2 = "Oregon State University";
const LINE_RIGHT = "Robotics · Software · ML";
const PLACE = "Corvallis, Oregon";

/* What turns behind the figure: the project pages themselves, shot at phone
   size by scripts/shots.mjs. The reference floats app screens; these are the
   real thing, which means they cannot drift from the site the way a mockup
   does. The slug is derived from the route, so a new project joins the wheel
   by existing — and the last segment of `site` is exactly what shots.mjs
   names its output. */
const shots = works.map((work) => ({
  title: work.title,
  slug: work.site.replace(/\/$/, "").split("/").pop() || "",
}));
/* Each project sits on the ring twice. The ring is concave, so only its far
   half is ever on screen — seven cards on a full circle would show three at a
   time, and the reference wraps the figure in six. Fourteen slots keep the
   spin continuous and the visible arc full. */
const wheel = [...shots, ...shots];
const step = 360 / Math.max(wheel.length, 1);

/* A phone screenshot is 390x844; the card is drawn at 420 wide. */
const SHOT_WIDTH = 420;
const SHOT_HEIGHT = 909;

/* The smallest candidate's own pixels, after the transparent margin was
   trimmed off, so the box is reserved at the right ratio before the file
   arrives. He now renders about 245 CSS px wide on a 900px-tall desktop
   viewport and about 170 on a phone, so 500w covers 2x and 760w covers 3x.
   Anything larger is bytes the layout cannot use. */
const FIGURE_WIDTH = 500;
const FIGURE_HEIGHT = 1214;
---

<section class="anime-hero" id="home" aria-label="Introduction">
  <h1 class="u-sr-only">Jakhangir Tynshimov</h1>
  <p class="u-sr-only">{LINE_RIGHT}. {LINE_LEFT}, {LINE_LEFT_2}.</p>

  <p class="anime-hero__place" aria-hidden="true">{PLACE}</p>

  <div class="anime-hero__stage js-anime-hero">
    <div class="anime-hero__wheel js-anime-wheel" aria-hidden="true">
      {
        wheel.map((work, index) => (
          <div
            class="anime-hero__screen"
            style={`--angle:${index * step}; --turn:${index * step}deg;`}
          >
            <img
              src={`/shots/${work.slug}.webp`}
              alt=""
              width={SHOT_WIDTH}
              height={SHOT_HEIGHT}
              loading="eager"
              decoding="async"
            />
          </div>
        ))
      }
    </div>

    {/* The drawn figure: the owner, standing in front of the headline with the
        wheel turning behind him. Decorative — the `h1` above carries his name
        and the headline repeats it — so no alt text, and the slot keeps its
        `aria-hidden`. Eager and high priority: it is the largest thing on the
        first screen, so it is the LCP candidate. */}
    <div class="anime-hero__figure" aria-hidden="true">
      <img
        src="/hero/jak-500.webp"
        srcset="/hero/jak-500.webp 500w, /hero/jak-760.webp 760w"
        sizes="(max-width: 48em) 170px, 290px"
        alt=""
        width={FIGURE_WIDTH}
        height={FIGURE_HEIGHT}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <svg
      class="anime-hero__headline"
      viewBox="0 0 1000 260"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <path id="anime-hero-arc" d="M 30 190 Q 500 60 970 190" fill="none" />
      </defs>
      {/* The two names ride the same arc from opposite corners and leave the
          middle to the figure. textLength pins each word to a fixed stretch of
          the arc however long it is, and spacingAndGlyphs condenses the glyphs
          rather than only tightening the gaps — the weight-and-width the
          reference's display face has. */}
      <text textLength="400" lengthAdjust="spacingAndGlyphs">
        <textPath href="#anime-hero-arc" startOffset="0%">{HEADLINE_LEFT}</textPath>
      </text>
      <text textLength="400" lengthAdjust="spacingAndGlyphs">
        <textPath href="#anime-hero-arc" startOffset="100%" text-anchor="end">
          {HEADLINE_RIGHT}
        </textPath>
      </text>
    </svg>

    {/* Two soft edges rather than one vignette: the reference blurs only the
        left and right, so the wheel reads as passing behind a lens while the
        top and bottom of the frame stay sharp. */}
    <div class="anime-hero__lens anime-hero__lens--left" aria-hidden="true"></div>
    <div class="anime-hero__lens anime-hero__lens--right" aria-hidden="true"></div>
  </div>

  {/* Left and right of the figure, the way the reference splits its two
      lines, rather than stacked under it. */}
  <div class="anime-hero__lines" aria-hidden="true">
    <p class="anime-hero__line anime-hero__line--left">
      {LINE_LEFT}<br />{LINE_LEFT_2}
    </p>
    <p class="anime-hero__line anime-hero__line--right">{LINE_RIGHT}</p>
  </div>

  <a class="anime-hero__explore" href="#work">
    Explore
    <span aria-hidden="true">↓</span>
  </a>
</section>

<script>
  import { initAnimeHero } from "../utils/AnimeHero";
  initAnimeHero();
</script>

<style lang="scss">
  @use "../styles/helpers/colors" as *;
  @use "../styles/helpers/fonts" as *;
  @use "../styles/helpers/responsive" as *;

  .anime-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    /* Small viewport units: the address bar on a phone must not be able to
       push the Explore link off the bottom of the first screen. */
    min-height: 100svh;
    padding: 6rem 1.5rem 3rem;

    background: color(secondary);
    color: color(primary);
    overflow: hidden;
  }

  .anime-hero__stage {
    position: relative;
    width: 100%;
    /* Edge to edge: the ring is meant to wrap the whole first screen, so the
       stage no longer stops at a reading measure. */
    max-width: none;
    /* Wider than tall: the ring is a shallow ellipse on screen, so a squarer
       stage only adds empty ground under it. */
    aspect-ratio: 1000 / 440;

    /* The wheel's children are laid out in 3D against this. */
    perspective: 1400px;
  }

  .anime-hero__wheel {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;

    /* Only the tilt lives here, and it is a transform rather than a custom
       property: a property set on an ancestor invalidates the style of every
       node beneath it, which is the most expensive mistake this repository has
       made. A transform does not. The turn itself is written on each card.
       The base of -9 degrees lays the ring slightly away from the viewer so it
       reads as a wheel rather than a flat circle of cards. */
    /* The controller replaces this whole declaration each frame. The resting
       value has to match its BASE_TILT or the first written frame jumps. */
    transform: rotateX(-9deg);
    will-change: transform;
    /* Decoration, and hidden from assistive tech already. The near half of
       the ring is faded to nothing but still a box, 4-5x magnified, and it
       passed over the Explore link often enough to swallow most clicks on it
       — every click under reduced motion, where the ring never turns. */
    pointer-events: none;
  }

  .anime-hero__screen {
    position: absolute;
    top: 50%;
    left: 50%;
    /* Laid out at the size the card reaches at the edge of the visible arc
       (1.4x the centre), then statically scaled down to 0.715 in the transform
       below, so the GPU only ever downsamples the raster — invariant 7. The
       centre card renders at 176px on a wide desktop. */
    width: clamp(134px, 16.1vw, 246px);
    /* Half the width, so the card's own centre sits on the ring's axis. The
       three clamp bounds have to stay in step with the width above. */
    margin-left: clamp(-123px, -8.05vw, -67px);

    /* A concave ring: the circle's centre sits in front of the stage, so the
       arc the viewer sees is its far side — the middle card is deepest and the
       cards at the edges come forward and grow, the way the reference's
       phones wrap around the figure. Step forward by the radius, turn to this
       card's place, step back along the turned z, and leave it turned: on the
       far side of that circle a card's front faces the centre, so the viewer
       sees every screen's face while the ones at the edges angle inward —
       the inside of a half-cylinder, not a row of billboards. The near half
       of the circle would land between the viewer and the figure: its faces
       point away, so backface-visibility drops it in every engine, and the
       cos() ramp fades the cards out before they get there where the engine
       has trig. `--turn` is the card's own angle plus the wheel's rotation,
       and the controller writes it here, on the leaf that consumes it. */
    --ring: clamp(300px, 36vw, 560px);
    transform: translateY(-50%) translateZ(var(--ring)) rotateY(var(--turn, 0deg))
      translateZ(calc(-1 * var(--ring))) scale(0.715);
    transform-style: preserve-3d;
    backface-visibility: hidden;
    opacity: clamp(0, cos(var(--turn, 0deg)) * 2.2, 1);

    /* The phone is drawn here rather than baked into the screenshot: a CSS
       bezel costs no bytes, stays crisp at any size, and follows the theme.
       Layout values are the rendered ones divided by the 0.715 static scale:
       8px of bezel renders as 5.7, the 22px corner as 15.7 and the image's
       14px corner as 10, concentric with it. The edge is the first shadow, a
       hairline ring, so there is no border to add to the box; the outer
       shadow's extent is unchanged, so the layer's bounds do not grow. The
       image keeps its own radius and the card has no overflow rule, so
       nothing here is a clip layer. */
    padding: 8px;
    border-radius: 22px;
    background: color(secondary);
    box-shadow:
      0 0 0 1.4px rgba(11, 11, 12, 0.07),
      0 1px 2px rgba(11, 11, 12, 0.05),
      0 10px 24px rgba(11, 11, 12, 0.06);

    img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 14px;
      /* Scenery, not the subject. These pages are dark-themed, so against a
         white hero they arrive as black bricks: drained, lifted hard and held
         well back, they read as pale ghosts the way the reference's screens
         do, while still being distinguishable from one another. */
      filter: grayscale(0.9) brightness(1.9) contrast(0.62);
      opacity: 0.42;
    }
  }

  .anime-hero__figure {
    position: absolute;
    z-index: 3;
    left: 50%;
    /* Sized by height, not width: a standing person in a stage that is wider
       than it is tall, and at this ratio (0.41) a width rule would decide his
       height for him. Two bounds: the viewport, so he stays the subject of the
       first screen, and the stage, so a tall narrow window (a portrait tablet,
       where the stage is short) cannot send him through the arc and out of
       the hero's clipped top — 118% of the stage keeps his cap just above
       it. He stands a little above the stage's floor so the lowest cards pass
       under his feet. */
    height: clamp(320px, min(64svh, 118%), 700px);
    bottom: 6%;
    transform: translateX(-50%);

    img {
      display: block;
      height: 100%;
      width: auto;
    }
  }

  .anime-hero__headline {
    position: absolute;
    /* Above the wheel, below the figure: the reference's screens pass behind
       the headline and the character stands in front of it. */
    z-index: 2;
    inset: auto 0 auto 0;
    /* Above the stage, not inside it. The figure is two thirds of the screen
       tall now, so an arc at 6% crossed his chest and his jacket swallowed
       the middle of the name; from here only his cap and shoulders cut into
       the letters, which is the overlap the composition wants. */
    top: -12%;
    width: 100%;
    height: auto;
    overflow: visible;

    text {
      font-family: font-family(bigger);
      font-size: 118px;
      font-weight: 400;
      letter-spacing: -0.02em;
      fill: color(primary);
    }
  }

  .anime-hero__lens {
    position: absolute;
    z-index: 4;
    top: 0;
    bottom: 0;
    width: clamp(40px, 8vw, 130px);
    pointer-events: none;

    backdrop-filter: blur(9px);
    -webkit-backdrop-filter: blur(9px);
    /* The mask is what keeps the blur from having a visible edge: it fades to
       nothing before it reaches the middle of the frame. */
    mask-image: linear-gradient(to var(--to), #000, transparent);
    -webkit-mask-image: linear-gradient(to var(--to), #000, transparent);
  }

  .anime-hero__lens--left {
    left: 0;
    --to: right;
  }

  .anime-hero__lens--right {
    right: 0;
    --to: left;
  }

  .anime-hero__place {
    position: absolute;
    top: 1.75rem;
    left: 1.75rem;
    margin: 0;

    font: 400 0.6875rem / 1 font-family(fraktion);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color(ink-soft);
  }

  .anime-hero__lines {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    width: 100%;
    max-width: 940px;
    margin-top: 1rem;
  }

  .anime-hero__line {
    margin: 0;
    font: 400 clamp(0.75rem, 1vw, 0.9375rem) / 1.4 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color(ink-soft);
  }

  .anime-hero__line--right {
    color: color(primary);
    text-align: right;
  }

  @include mq(phone) {
    .anime-hero__lines {
      justify-content: center;
      text-align: center;
    }

    .anime-hero__line--right {
      text-align: center;
    }
  }

  .anime-hero__explore {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-top: 2rem;
    padding: 0.75rem 1.25rem;

    border: 1px solid color(primary);
    border-radius: 999px;

    font: 700 0.6875rem / 1 font-family(fraktion);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: color(primary);

    transition: background-color 240ms ease, color 240ms ease;

    &:hover,
    &:focus-visible {
      background: color(primary);
      color: color(secondary);
    }
  }

  @include mq(phone) {
    .anime-hero {
      padding-top: 5rem;
    }

    .anime-hero__stage {
      aspect-ratio: 1 / 1.05;
    }

    .anime-hero__headline text {
      font-size: 150px;
    }

    /* A phone is tall and narrow: the same fraction of the viewport would put
       his cap through the top edge, so he is a little shorter here. */
    .anime-hero__figure {
      height: clamp(240px, min(46svh, 118%), 480px);
    }

    /* The arc is only 342px wide here while he is 195px of it, so the name
       has to clear his shoulders entirely rather than merely his chest. */
    .anime-hero__headline {
      top: -30%;
    }
  }
</style>
