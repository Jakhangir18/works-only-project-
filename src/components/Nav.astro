---
const items = [
  { label: "Work", href: "/#work" },
  { label: "About", href: "/#about" },
  { label: "Contact", href: "/#contact" },
];
---

<header class="nav wrap">
  <a href="/" class="nav__mark mono" aria-label="Jakhangir Tynshimov, home">JT</a>
  <nav aria-label="Primary" class="nav__links mono">
    {items.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</header>

<style lang="scss">
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--nav-h);
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }

  .nav__mark {
    letter-spacing: 0.16em;
  }

  .nav__links {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.5rem);

    a {
      padding-block: 0.5rem;
      color: var(--ink-2);
      transition: color var(--dur) var(--ease);

      &:hover,
      &:focus-visible {
        color: var(--ink);
      }
    }
  }
</style>
