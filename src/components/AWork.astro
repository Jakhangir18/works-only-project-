---
import type { WorkCover, WorkPalette, WorkPoster, WorkSize } from "../data/works";

interface Props {
  caption: string;
  cssClass: string;
  index: string;
  site: string;
  total: string;
  size: WorkSize;
  palette: WorkPalette;
  poster: WorkPoster;
  cover?: WorkCover;
}

const { caption, cssClass, index, site, total, size, palette, poster, cover } =
  Astro.props;

/**
 * The palette background as bare "r, g, b", so the scrim can fade the card's
 * own colour to nothing in a gradient. rgba() with custom properties works
 * back to Safari 15; color-mix, which would take the hex directly, is 16.2.
 */
function toRgbChannels(hex: string): string {
  const value = hex.trim().replace(/^#/, "");
  // Validated rather than parsed leniently: parseInt stops at the first
  // non-hex character, so "#ff00zz" would come back bright green, and a
  // four-digit or rgb() value would come back black — a plate in a colour the
  // card is not, over the project's own photograph, with nothing failing.
  if (!/^([0-9a-f]{3,4}|[0-9a-f]{6,8})$/i.test(value)) {
    throw new Error(
      `works.ts palette.background must be a hex colour; got "${hex}". ` +
        "The card's text plate and edge scrim are built from its channels.",
    );
  }
  // Alpha, where present, is dropped: the plate applies its own.
  const full =
    value.length <= 4
      ? value.slice(0, 3).split("").map((c) => c + c).join("")
      : value.slice(0, 6);
  const n = Number.parseInt(full, 16);
  return `${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}`;
}

const cardBgChannels = toRgbChannels(palette.background);

// The cover has no src at parse time and no loading="lazy". The card holds
// its URL in data-src and WorkSection.prepareCoverWindow assigns it a few
// cards ahead of the scrub. Adding lazy loading on top deferred that
// assignment a second time: the cards sit under content-visibility: hidden,
// so the browser never considered them near the viewport, and the bytes
// landed one per ~1.8 s during the scrub instead of before it.
const key = `${index}/${total}`;
const isInternal = site.startsWith("/");
const motifClass = `a__card__poster--${poster.motif}`;
---

<a-work
  class:list={[cssClass, `a-work--${size}`]}
  data-work-index={index}
  data-work-total={total}
  data-poster-mark={poster.mark}
  data-poster-motif={poster.motif}
  progress="1"
>
  <div class="a__inner">
    <a
      href={site}
      target={isInternal ? "_self" : "_blank"}
      rel={isInternal ? undefined : "noopener noreferrer"}
    >
      <div
        class="a__card"
        style={`background:${palette.background};--card-bg-rgb:${cardBgChannels};`}
      >
        <div
          class:list={["a__card__poster", motifClass]}
          style={`color:${palette.accent};`}
          aria-hidden="true"
        >
          <span class="a__card__poster-mark">{poster.mark}</span>
        </div>
        {
          cover && (
            <img
              data-src={cover.src}
              alt={cover.alt}
              width={cover.width}
              height={cover.height}
              class="a__card__cover"
              decoding="async"
              style={`object-position:${cover.focalPoint.x} ${cover.focalPoint.y};`}
            />
          )
        }
        {/* The colour stays on the block, not the span: DiveTransition.readCard
            takes the project's accent from this element's inline style to paint
            the overlay, and moving it inside took the accent off every dive.
            The span inherits it and exists only to carry the plate. */}
        <div class="a__card__index" style={`color:${palette.accent};`}>
          <span>{index}</span>
        </div>
        <div class="a__card__title" style={`color:#fff;`}>
          <span>{caption}</span>
        </div>
        <div class="a__card__cta" style={`color:${palette.accent};`}>
          <span>View project →</span>
        </div>
        <div class="a__card__grid"></div>
      </div>

      <div class="a__caption">
        <div class="a__caption__text">{caption}</div>
        <div class="a__caption__key">#{key}</div>
      </div>
    </a>
  </div>
</a-work>

<script>
  class AWork extends HTMLElement {
    static observedAttributes = ["progress"];

    link: HTMLAnchorElement | null = null;
    cover: HTMLImageElement | null = null;
    coverPromise: Promise<boolean> | null = null;

    connectedCallback() {
      this.link = this.querySelector("a") as HTMLAnchorElement | null;
      this.cover = this.querySelector(
        ".a__card__cover",
      ) as HTMLImageElement | null;

      if (!this.link) return;

      const progress = this.getAttribute("progress");
      if (progress !== null) {
        this.syncProgressState(progress);
      }

      // Stable handler identity: connectedCallback re-fires every time the
      // ScrollTrigger pin re-parents the container (each resize), and a
      // fresh bind() stacked a duplicate listener per reconnection.
      this.link.addEventListener("click", this.onClick);
      this.cover?.addEventListener("error", this.onCoverError);
    }

    attributeChangedCallback(
      name: string,
      _oldValue: string | null,
      newValue: string | null,
    ) {
      if (name === "progress" && newValue !== null) {
        this.style.setProperty("--progress", newValue);
        this.syncProgressState(newValue);
      }
    }

    syncProgressState(progress: string) {
      if (progress === "1" || progress === "-1") {
        this.classList.remove("is-inview");
      } else {
        this.classList.add("is-inview");
      }
    }

    onClick = (event: MouseEvent) => {
      if (this.link?.href.includes("#")) {
        event.preventDefault();
      }
    };

    prepareCover() {
      if (!this.cover) return Promise.resolve(false);
      if (this.coverPromise) return this.coverPromise;

      const src = this.cover.dataset.src;
      if (!src) return Promise.resolve(false);

      this.dataset.coverState = "loading";
      if (!this.cover.getAttribute("src")) this.cover.src = src;

      this.coverPromise = this.cover
        .decode()
        .then(() => {
          this.dataset.coverState = "ready";
          this.classList.add("is-cover-ready");
          return true;
        })
        .catch(() => {
          this.onCoverError();
          return false;
        });

      return this.coverPromise;
    }

    onCoverError = () => {
      this.dataset.coverState = "error";
      this.classList.remove("is-cover-ready");
    };
  }

  customElements.define("a-work", AWork);
</script>

<style lang="scss">
  :global(html.is-safari) a-work {
    content-visibility: visible;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    background: transparent;
  }

  :global(html.is-safari) a-work.is-inview {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  a-work {
    position: relative;
    top: 0;
    left: 0;

    display: block;
    margin: 0;
    padding: 0.5rem 0.5rem 0;

    background: color(secondary);
    content-visibility: hidden;

    transform-style: preserve-3d;

    will-change: transform;

    @include mq(phone) {
      padding: 0.25rem;
    }

    a {
      display: block;
      text-decoration: none;
    }

    .a__inner {
      display: block;
      margin: 0;
      padding: 0;
    }

    .a__card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;

      /* Explicit width, never `auto`. Inside an absolutely positioned a-work,
         `auto` is shrink-to-fit over the title's max-content, so the box
         depended on two things it should not: per-engine text metrics (420 /
         434 / 438 px for the same title in Chromium / Firefox / WebKit) and
         whether a-work was still size-contained by `content-visibility:
         hidden`, which collapses it and leaves the card on its transferred
         minimum (288x180) until it scrolls in. The clamp floor is that same
         288, so min-width/min-height stay inert and the ratio stays exact. */
      width: 340px;
      max-width: 50vw;
      height: auto;
      max-height: 50vh;
      min-width: 280px;
      min-height: 180px;
      aspect-ratio: 16 / 10;

      padding: 1.25rem 1.5rem;
      box-sizing: border-box;
      border: 1px solid rgba(255, 255, 255, 0.08);

      @include mq(phone) {
        /* 208x130 is exactly what every engine already resolved here (the
           transferred minimum of min-height: 130px); pinning it keeps the
           phone box unchanged while removing the content dependence. */
        width: 208px;
        max-width: 80vw;
        max-height: 80vh;
        min-width: 200px;
        min-height: 130px;

      }
    }

    &.a-work--feature .a__card {
      width: 390px;

      @include mq(phone) {
        width: 240px;
      }
    }

    &.a-work--hero .a__card {
      width: 440px;

      @include mq(phone) {
        width: 272px;
      }
    }

    .a__card__poster {
      position: absolute;
      inset: 0;
      z-index: 0;

      overflow: hidden;

      opacity: 0.72;
      pointer-events: none;

      &::before,
      &::after {
        position: absolute;

        content: "";
      }
    }

    .a__card__poster-mark {
      position: absolute;
      top: 50%;
      left: 50%;

      color: currentcolor;
      font: 700 clamp(3.5rem, 8vw, 7rem) / 1 font-family(bigger);
      letter-spacing: -0.08em;

      opacity: 0.1;
      transform: translate(-50%, -50%);
    }

    .a__card__poster--orbit {
      background:
        radial-gradient(circle at 50% 50%, currentcolor 0 1px, transparent 2px),
        radial-gradient(circle at 50% 50%, transparent 0 24%, currentcolor 24.3% 24.8%, transparent 25.1%),
        radial-gradient(circle at 50% 50%, transparent 0 42%, currentcolor 42.3% 42.7%, transparent 43%);

      &::before {
        top: 50%;
        left: 50%;

        width: 72%;
        height: 38%;

        border: 1px solid currentcolor;
        border-radius: 50%;

        opacity: 0.28;
        transform: translate(-50%, -50%) rotate(-18deg);
      }
    }

    .a__card__poster--crosshair {
      background:
        linear-gradient(90deg, transparent 49.8%, currentcolor 50%, transparent 50.2%),
        linear-gradient(transparent 49.8%, currentcolor 50%, transparent 50.2%);

      &::before {
        top: 50%;
        left: 50%;

        width: 38%;
        aspect-ratio: 1;

        border: 1px solid currentcolor;
        border-radius: 50%;

        opacity: 0.24;
        transform: translate(-50%, -50%);
      }
    }

    .a__card__poster--signal {
      background: repeating-linear-gradient(
        90deg,
        transparent 0 11%,
        currentcolor 11.2% 11.45%,
        transparent 11.7% 22%
      );

      &::before {
        right: 7%;
        bottom: 13%;
        left: 7%;

        height: 34%;

        border-top: 1px solid currentcolor;
        border-bottom: 1px solid currentcolor;

        opacity: 0.26;
        transform: skewY(-7deg);
      }
    }

    .a__card__poster--trajectory {
      background: linear-gradient(
        148deg,
        transparent 0 45%,
        currentcolor 45.2% 45.5%,
        transparent 45.8%
      );

      &::before {
        top: 12%;
        right: 14%;

        width: 42%;
        aspect-ratio: 1;

        border: 1px solid currentcolor;
        border-left-color: transparent;
        border-radius: 50%;

        opacity: 0.34;
        transform: rotate(-38deg);
      }
    }

    .a__card__cover {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 1;
      opacity: 0;
      transition:
        opacity 0.3s ease,
        transform 0.5s ease;
    }

    &.is-cover-ready .a__card__cover {
      opacity: 1;
    }

    &.is-cover-ready .a__card:hover .a__card__cover {
      opacity: 1;
      transform: scale(1.03);
    }

    /* The card's text sits on the project's own photograph, and a photograph is
       whatever it is: measured over the covers as shipped, the title read
       between 2.0:1 and 4.8:1 and the index numeral between 1.2:1 and 9.7:1,
       against the 3:1 and 4.5:1 those sizes need — the clinic cover is a white
       web page and its title was white on white.

       A scrim at the card's edges was the first attempt and it does not
       survive the tunnel: cards are scaled down as they recede, so a gradient
       deep enough to sit behind the title on a small card covers the whole
       photograph. The plate goes behind the glyphs instead, one strip per line
       of text, so it is the same size relative to the words at every scale and
       the rest of the image is untouched. box-decoration-break is what makes a
       wrapped title get one strip per line rather than one box around both. */
    .a__card__index span,
    .a__card__title span,
    .a__card__cta span {
      // Opaque, not 88%. Two translucent strips that overlap composite to a
      // darker band, and they do overlap: the strip covers the font's content
      // area, which for this display face runs past the 1.1 line box by about
      // a quarter of its height — measured 7 to 24 px of overlap on the three
      // titles that wrap. Raising the leading enough to clear it needs 1.51,
      // which is airy for a display face; an opaque plate makes the overlap
      // invisible instead, and costs 12% of a photograph that is already
      // mostly hidden behind the words.
      background: rgb(var(--card-bg-rgb, 17, 17, 17));
      box-decoration-break: clone;
      -webkit-box-decoration-break: clone;
      // No vertical padding. A strip taller than its own line box overlaps the
      // strip above it on a wrapped title, and two 0.88 plates composite to
      // 0.986 — measured as a hard dark stripe across the width of the shorter
      // line on three of the seven titles.
      padding: 0 0.34em;
      margin: 0 -0.34em;
    }

    // letter-spacing emits its space after the last glyph too, inside the box
    // the plate paints, so the strip ends further past the last letter than it
    // starts before the first. The right padding is reduced by that much: a
    // negative margin cannot fix it, because margins do not move an inline
    // element's background box — they only move the line.
    .a__card__index span {
      padding-right: calc(0.34em - 0.2em);
    }

    .a__card__cta span {
      padding-right: calc(0.34em - 0.15em);
    }

    /* A light edge scrim still, because a plate the width of the words leaves
       the corners of a busy photograph fighting the card's own frame. Shallow
       enough that the middle of every cover is untouched at any scale. */
    // Only once the cover is actually showing. The poster motif is the visual
    // for a card with no cover and the fallback while one loads, and it runs to
    // the card's edges — washing it 55% at both ends leaves it looking
    // half-erased. z-index 1 rather than 2 puts the scrim above the cover and
    // below the dot grid, which is meant to read evenly across the whole card.
    // It fades in on the same 0.3s as the cover, because the class that reveals
    // the cover is the class that reveals this: switching it on instantly put
    // the wash on the poster for the 300 ms the photograph was still fading up.
    .a__card::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.3s ease;
      background:
        linear-gradient(
          to bottom,
          rgba(var(--card-bg-rgb, 17, 17, 17), 0.55) 0%,
          rgba(var(--card-bg-rgb, 17, 17, 17), 0) 22%
        ),
        linear-gradient(
          to top,
          rgba(var(--card-bg-rgb, 17, 17, 17), 0.55) 0%,
          rgba(var(--card-bg-rgb, 17, 17, 17), 0) 26%
        );
    }

    &.is-cover-ready .a__card::after {
      opacity: 1;
    }

    .a__card__grid {
      position: absolute;
      inset: 0;
      background-image: radial-gradient(
        circle,
        rgba(255, 255, 255, 0.06) 1px,
        transparent 1px
      );
      background-size: 24px 24px;
      z-index: 2;
      pointer-events: none;
    }

    .a__card__index {
      font: 700 11px / 1 font-family(fraktion);
      letter-spacing: 0.2em;
      text-transform: uppercase;
      // 0.7 put the two darkest accents at 4.02:1 and 4.23:1 against the 4.5:1
      // that 11px text needs. At full strength the same two measure 7.18:1 and
      // 7.55:1, and the numeral is still the quietest thing on the card —
      // eleven pixels of letter-spaced accent against a title six times its
      // size.
      opacity: 1;
      position: relative;
      z-index: 3;
    }

    .a__card__title {
      font: 700 clamp(1.25rem, 3.5vw, 2.5rem) / 1.1 font-family(editorial);
      text-transform: uppercase;
      letter-spacing: -0.02em;
      position: relative;
      z-index: 3;
    }

    .a__card__cta {
      font: 700 11px / 1 font-family(fraktion);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      position: relative;
      z-index: 3;
    }

    .a__caption {
      @include flex(row, center, space-between);

      padding: 0.5rem 0.5rem;

      color: color(primary);
      font: 700 11px / 1 font-family(fraktion);
      letter-spacing: 0.15em;
      text-align: right;
      text-transform: uppercase;

      @include mq(phone) {
        display: none;
      }
    }

    &.is-inview {
      content-visibility: visible;
    }
  }
</style>
