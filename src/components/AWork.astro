---
import type { WorkCover, WorkPalette, WorkPoster, WorkSize } from "../data/works";

interface Props {
  caption: string;
  cssClass: string;
  index: string;
  site: string;
  total: string;
  size: WorkSize;
  palette: WorkPalette;
  poster: WorkPoster;
  cover?: WorkCover;
}

const { caption, cssClass, index, site, total, size, palette, poster, cover } =
  Astro.props;

// The cover has no src at parse time and no loading="lazy". The card holds
// its URL in data-src and WorkSection.prepareCoverWindow assigns it a few
// cards ahead of the scrub. Adding lazy loading on top deferred that
// assignment a second time: the cards sit under content-visibility: hidden,
// so the browser never considered them near the viewport, and the bytes
// landed one per ~1.8 s during the scrub instead of before it.
const key = `${index}/${total}`;
const isInternal = site.startsWith("/");
const motifClass = `a__card__poster--${poster.motif}`;
---

<a-work
  class:list={[cssClass, `a-work--${size}`]}
  data-work-index={index}
  data-work-total={total}
  data-poster-mark={poster.mark}
  data-poster-motif={poster.motif}
  progress="1"
>
  <div class="a__inner">
    <a
      href={site}
      target={isInternal ? "_self" : "_blank"}
      rel={isInternal ? undefined : "noopener noreferrer"}
    >
      <div class="a__card" style={`background:${palette.background};`}>
        <div
          class:list={["a__card__poster", motifClass]}
          style={`color:${palette.accent};`}
          aria-hidden="true"
        >
          <span class="a__card__poster-mark">{poster.mark}</span>
        </div>
        {
          cover && (
            <img
              data-src={cover.src}
              alt={cover.alt}
              width={cover.width}
              height={cover.height}
              class="a__card__cover"
              decoding="async"
              style={`object-position:${cover.focalPoint.x} ${cover.focalPoint.y};`}
            />
          )
        }
        <div class="a__card__index" style={`color:${palette.accent};`}>
          {index}
        </div>
        <div class="a__card__title" style={`color:#fff;`}>{caption}</div>
        <div class="a__card__cta" style={`color:${palette.accent};`}>
          View project →
        </div>
        <div class="a__card__grid"></div>
      </div>

      <div class="a__caption">
        <div class="a__caption__text">{caption}</div>
        <div class="a__caption__key">#{key}</div>
      </div>
    </a>
  </div>
</a-work>

<script>
  class AWork extends HTMLElement {
    static observedAttributes = ["progress"];

    link: HTMLAnchorElement | null = null;
    cover: HTMLImageElement | null = null;
    coverPromise: Promise<boolean> | null = null;

    connectedCallback() {
      this.link = this.querySelector("a") as HTMLAnchorElement | null;
      this.cover = this.querySelector(
        ".a__card__cover",
      ) as HTMLImageElement | null;

      if (!this.link) return;

      const progress = this.getAttribute("progress");
      if (progress !== null) {
        this.syncProgressState(progress);
      }

      // Stable handler identity: connectedCallback re-fires every time the
      // ScrollTrigger pin re-parents the container (each resize), and a
      // fresh bind() stacked a duplicate listener per reconnection.
      this.link.addEventListener("click", this.onClick);
      this.cover?.addEventListener("error", this.onCoverError);
    }

    attributeChangedCallback(
      name: string,
      _oldValue: string | null,
      newValue: string | null,
    ) {
      if (name === "progress" && newValue !== null) {
        this.style.setProperty("--progress", newValue);
        this.syncProgressState(newValue);
      }
    }

    syncProgressState(progress: string) {
      if (progress === "1" || progress === "-1") {
        this.classList.remove("is-inview");
      } else {
        this.classList.add("is-inview");
      }
    }

    onClick = (event: MouseEvent) => {
      if (this.link?.href.includes("#")) {
        event.preventDefault();
      }
    };

    prepareCover() {
      if (!this.cover) return Promise.resolve(false);
      if (this.coverPromise) return this.coverPromise;

      const src = this.cover.dataset.src;
      if (!src) return Promise.resolve(false);

      this.dataset.coverState = "loading";
      if (!this.cover.getAttribute("src")) this.cover.src = src;

      this.coverPromise = this.cover
        .decode()
        .then(() => {
          this.dataset.coverState = "ready";
          this.classList.add("is-cover-ready");
          return true;
        })
        .catch(() => {
          this.onCoverError();
          return false;
        });

      return this.coverPromise;
    }

    onCoverError = () => {
      this.dataset.coverState = "error";
      this.classList.remove("is-cover-ready");
    };
  }

  customElements.define("a-work", AWork);
</script>

<style lang="scss">
  :global(html.is-safari) a-work {
    content-visibility: visible;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    background: transparent;
  }

  :global(html.is-safari) a-work.is-inview {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  a-work {
    position: relative;
    top: 0;
    left: 0;

    display: block;
    margin: 0;
    padding: 0.5rem 0.5rem 0;

    background: color(secondary);
    content-visibility: hidden;

    transform-style: preserve-3d;

    will-change: transform;

    @include mq(phone) {
      padding: 0.25rem;
    }

    a {
      display: block;
      text-decoration: none;
    }

    .a__inner {
      display: block;
      margin: 0;
      padding: 0;
    }

    .a__card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;

      /* Explicit width, never `auto`. Inside an absolutely positioned a-work,
         `auto` is shrink-to-fit over the title's max-content, so the box
         depended on two things it should not: per-engine text metrics (420 /
         434 / 438 px for the same title in Chromium / Firefox / WebKit) and
         whether a-work was still size-contained by `content-visibility:
         hidden`, which collapses it and leaves the card on its transferred
         minimum (288x180) until it scrolls in. The clamp floor is that same
         288, so min-width/min-height stay inert and the ratio stays exact. */
      width: 340px;
      max-width: 50vw;
      height: auto;
      max-height: 50vh;
      min-width: 280px;
      min-height: 180px;
      aspect-ratio: 16 / 10;

      padding: 1.25rem 1.5rem;
      box-sizing: border-box;
      border: 1px solid rgba(255, 255, 255, 0.08);

      @include mq(phone) {
        /* 208x130 is exactly what every engine already resolved here (the
           transferred minimum of min-height: 130px); pinning it keeps the
           phone box unchanged while removing the content dependence. */
        width: 208px;
        max-width: 80vw;
        max-height: 80vh;
        min-width: 200px;
        min-height: 130px;

      }
    }

    &.a-work--feature .a__card {
      width: 390px;

      @include mq(phone) {
        width: 240px;
      }
    }

    &.a-work--hero .a__card {
      width: 440px;

      @include mq(phone) {
        width: 272px;
      }
    }

    .a__card__poster {
      position: absolute;
      inset: 0;
      z-index: 0;

      overflow: hidden;

      opacity: 0.72;
      pointer-events: none;

      &::before,
      &::after {
        position: absolute;

        content: "";
      }
    }

    .a__card__poster-mark {
      position: absolute;
      top: 50%;
      left: 50%;

      color: currentcolor;
      font: 700 clamp(3.5rem, 8vw, 7rem) / 1 font-family(bigger);
      letter-spacing: -0.08em;

      opacity: 0.1;
      transform: translate(-50%, -50%);
    }

    .a__card__poster--orbit {
      background:
        radial-gradient(circle at 50% 50%, currentcolor 0 1px, transparent 2px),
        radial-gradient(circle at 50% 50%, transparent 0 24%, currentcolor 24.3% 24.8%, transparent 25.1%),
        radial-gradient(circle at 50% 50%, transparent 0 42%, currentcolor 42.3% 42.7%, transparent 43%);

      &::before {
        top: 50%;
        left: 50%;

        width: 72%;
        height: 38%;

        border: 1px solid currentcolor;
        border-radius: 50%;

        opacity: 0.28;
        transform: translate(-50%, -50%) rotate(-18deg);
      }
    }

    .a__card__poster--crosshair {
      background:
        linear-gradient(90deg, transparent 49.8%, currentcolor 50%, transparent 50.2%),
        linear-gradient(transparent 49.8%, currentcolor 50%, transparent 50.2%);

      &::before {
        top: 50%;
        left: 50%;

        width: 38%;
        aspect-ratio: 1;

        border: 1px solid currentcolor;
        border-radius: 50%;

        opacity: 0.24;
        transform: translate(-50%, -50%);
      }
    }

    .a__card__poster--signal {
      background: repeating-linear-gradient(
        90deg,
        transparent 0 11%,
        currentcolor 11.2% 11.45%,
        transparent 11.7% 22%
      );

      &::before {
        right: 7%;
        bottom: 13%;
        left: 7%;

        height: 34%;

        border-top: 1px solid currentcolor;
        border-bottom: 1px solid currentcolor;

        opacity: 0.26;
        transform: skewY(-7deg);
      }
    }

    .a__card__poster--trajectory {
      background: linear-gradient(
        148deg,
        transparent 0 45%,
        currentcolor 45.2% 45.5%,
        transparent 45.8%
      );

      &::before {
        top: 12%;
        right: 14%;

        width: 42%;
        aspect-ratio: 1;

        border: 1px solid currentcolor;
        border-left-color: transparent;
        border-radius: 50%;

        opacity: 0.34;
        transform: rotate(-38deg);
      }
    }

    .a__card__cover {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 1;
      opacity: 0;
      transition:
        opacity 0.3s ease,
        transform 0.5s ease;
    }

    &.is-cover-ready .a__card__cover {
      opacity: 1;
    }

    &.is-cover-ready .a__card:hover .a__card__cover {
      opacity: 1;
      transform: scale(1.03);
    }

    .a__card__grid {
      position: absolute;
      inset: 0;
      background-image: radial-gradient(
        circle,
        rgba(255, 255, 255, 0.06) 1px,
        transparent 1px
      );
      background-size: 24px 24px;
      z-index: 2;
      pointer-events: none;
    }

    .a__card__index {
      font: 700 11px / 1 font-family(fraktion);
      letter-spacing: 0.2em;
      text-transform: uppercase;
      opacity: 0.7;
      position: relative;
      z-index: 3;
    }

    .a__card__title {
      font: 700 clamp(1.25rem, 3.5vw, 2.5rem) / 1.1 font-family(editorial);
      text-transform: uppercase;
      letter-spacing: -0.02em;
      position: relative;
      z-index: 3;
    }

    .a__card__cta {
      font: 700 11px / 1 font-family(fraktion);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      position: relative;
      z-index: 3;
    }

    .a__caption {
      @include flex(row, center, space-between);

      padding: 0.5rem 0.5rem;

      color: color(primary);
      font: 700 11px / 1 font-family(fraktion);
      letter-spacing: 0.15em;
      text-align: right;
      text-transform: uppercase;

      @include mq(phone) {
        display: none;
      }
    }

    &.is-inview {
      content-visibility: visible;
    }
  }
</style>
