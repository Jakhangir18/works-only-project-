---
// Tall spacer section that drives the rocket and text overlays.
// The section is intentionally empty and only exists to provide scroll range.
---

<section class="rocket-story js-rocket-story" aria-label="Rocket story">
  <!-- Spacer used only to create scroll range for the story animation. -->
</section>

<style lang="scss">
  .rocket-story {
    position: relative;
    height: 400vh;
    background: transparent;
    z-index: 0;
    pointer-events: none;

    @media (max-width: 576px) {
      height: 300vh;
    }
  }
</style>

<script>
  /**
   * RocketStorySection scroll handler.
   * Calculates progress (0..1) and updates rocket frame + text slides.
   * RAF-throttled so it runs at most once per frame on mobile.
   */
  import Emitter from "../utils/Emitter";

  (function initRocketStory() {
    const section = document.querySelector(".js-rocket-story") as HTMLElement;
    if (!section) return;

    // Cache elements and absolute geometry once; per-frame rect reads and
    // querySelector calls here ran page-wide on every scroll frame.
    const workSection = document.querySelector(".s-work") as HTMLElement | null;
    const rocketBg = document.querySelector(".js-rocket-bg") as HTMLElement | null;

    let sectionTop = 0;
    let sectionHeight = 1;
    let workTop = Infinity;
    let workBottom = Infinity;

    function measure() {
      const rect = section.getBoundingClientRect();
      sectionTop = rect.top + window.scrollY;
      sectionHeight = section.offsetHeight;
      if (workSection) {
        const workRect = workSection.getBoundingClientRect();
        workTop = workRect.top + window.scrollY;
        workBottom = workRect.bottom + window.scrollY;
      }
    }
    measure();

    let rafPending = false;
    // Captured in the scroll listener, before anything writes a style this
    // frame, so update() never has to ask the layout engine for it.
    let lastScrollY = window.scrollY;
    let hiddenApplied = false;

    function update() {
      rafPending = false;

      // scrollTop is captured by the scroll listener before any style is
      // written this frame; reading window.scrollY here instead forced a
      // style+layout pass inside frames the Work section was already busy in
      // (measured 100% forced layout on the long frames it appeared in).
      const scrollY = lastScrollY;
      const windowHeight = window.innerHeight;

      // Hide rocket while the work section is visible, approaching, or
      // already scrolled past — and apply that state only once.
      const workIsVisible =
        workTop - scrollY < windowHeight * 1.5 &&
        workBottom - scrollY > -windowHeight;
      const isPastWork = workBottom - scrollY < 0;

      if (workIsVisible || isPastWork) {
        if (!hiddenApplied) {
          hiddenApplied = true;
          rocketBg?.classList.remove("is-active");
          window.updateRocketFrame?.(0);
          window.updateRocketMotion?.(0);
          window.updateTextSlides?.(0);
        }
        return;
      }
      hiddenApplied = false;

      // Progress: 0 when section top is at window bottom, 1 when section bottom exits window top
      let rawProgress =
        (windowHeight - (sectionTop - scrollY)) / (sectionHeight + windowHeight);
      rawProgress = Math.max(0, Math.min(1, rawProgress));

      // Hold the first part of the section so the rocket does not jump on entry.
      const DELAY = 0.08;
      let progress = 0;
      if (rawProgress < DELAY) {
        progress = 0;
      } else {
        progress = (rawProgress - DELAY) / (1 - DELAY);
      }

      // Update rocket frame
      if (typeof window.updateRocketFrame === "function") {
        window.updateRocketFrame(progress);
      }

      // Update rocket rotation + position via GSAP timeline
      if (typeof window.updateRocketMotion === "function") {
        window.updateRocketMotion(progress);
      }

      // Update text slides
      if (typeof window.updateTextSlides === "function") {
        window.updateTextSlides(progress);
      }
    }

    function scheduleUpdate() {
      lastScrollY = window.scrollY;
      if (!rafPending) {
        rafPending = true;
        requestAnimationFrame(update);
      }
    }

    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener(
      "resize",
      () => {
        measure();
        scheduleUpdate();
      },
      { passive: true },
    );

    // Layout can settle after fonts/init — re-measure once everything is
    // loaded so the cached positions match the final document.
    window.addEventListener(
      "load",
      () => {
        measure();
        scheduleUpdate();
      },
      { once: true },
    );

    // The work section sets its --height after fonts settle, which moves
    // everything below it — re-measure when its init completes.
    Emitter.on(
      "worksReady",
      () => {
        measure();
        scheduleUpdate();
      },
      null,
    );

    // Initial call
    requestAnimationFrame(update);
  })();
</script>
