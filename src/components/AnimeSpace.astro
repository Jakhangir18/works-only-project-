---
/**
 * Where the flame hands the page over.
 *
 * The stars are one SVG written at build time — a fixed field rather than a
 * random one, so the page looks the same on every load and nothing has to be
 * generated in the browser. Two layers drift at different speeds on scroll,
 * which is the whole of the parallax: two transforms, no canvas, no loop.
 */

/* A deterministic field. A seeded generator rather than Math.random so the
   markup is byte-identical between builds and diffs stay readable. */
function field(count: number, seed: number) {
  let state = seed;
  const next = () => {
    // Numerical Recipes' LCG: small, well-distributed enough for scatter.
    state = (state * 1664525 + 1013904223) % 4294967296;
    return state / 4294967296;
  };
  return Array.from({ length: count }, () => ({
    x: Number((next() * 100).toFixed(2)),
    y: Number((next() * 100).toFixed(2)),
    r: Number((0.5 + next() * 1.3).toFixed(2)),
    o: Number((0.25 + next() * 0.6).toFixed(2)),
  }));
}

const far = field(120, 20260911);
const near = field(46, 7734121);
---

<section class="space" id="space">
  <div class="space__layer space__layer--far js-space-far" aria-hidden="true">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
      {far.map((s) => <circle cx={s.x} cy={s.y} r={s.r / 10} opacity={s.o} />)}
    </svg>
  </div>

  <div class="space__layer space__layer--near js-space-near" aria-hidden="true">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
      {near.map((s) => <circle cx={s.x} cy={s.y} r={s.r / 8} opacity={s.o} />)}
    </svg>
  </div>

</section>

<script>
  import { initSpace } from "../utils/Space";
  initSpace();
</script>

<style lang="scss">
  @use "../styles/helpers/colors" as *;
  @use "../styles/helpers/fonts" as *;
  @use "../styles/helpers/responsive" as *;

  .space {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 8rem 1.5rem;

    /* The colour the wipe lands on, declared once in the palette and shared
       with the wipe and the work panels, so the hand-off has no seam. A soft
       glow at the top is where the burst was. */
    background:
      radial-gradient(ellipse 70% 45% at 50% 0%, color-mix(in srgb, var(--color-space-glow) 35%, transparent), transparent 70%),
      color(space);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }

  .space__layer {
    position: absolute;
    inset: -10% 0;
    z-index: 0;
    pointer-events: none;

    /* The controller writes a translate here and nothing else. */
    transform: translate3d(0, var(--drift, 0px), 0);
    will-change: transform;

    svg {
      width: 100%;
      height: 100%;
    }

    circle {
      fill: #fff;
    }
  }

  .space__layer--near circle {
    fill: #ffd9a8;
  }

  @media (prefers-reduced-motion: reduce) {
    .space__layer {
      transform: none;
    }
  }
</style>
