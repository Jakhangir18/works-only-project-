---
interface Item {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ul class="gallery">
  {
    items.map((item) => (
      <li class="gallery__item reveal">
        <figure>
          <img
            src={item.src}
            alt={item.alt}
            width={item.width}
            height={item.height}
            loading="lazy"
            decoding="async"
          />
          {item.caption && <figcaption class="mono">{item.caption}</figcaption>}
        </figure>
      </li>
    ))
  }
</ul>

<style lang="scss">
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);

    @include mq(sm) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  figure {
    display: grid;
    gap: 0.75rem;
  }

  img {
    width: 100%;
    background: var(--rule);
  }

  figcaption {
    color: var(--ink-2);
    text-transform: none;
    letter-spacing: 0.02em;
  }
</style>
