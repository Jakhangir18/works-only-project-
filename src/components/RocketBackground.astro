---
// RocketBackground.astro
// Fixed background layer rendering the rocket frame sequence.
// Positioned behind all content, responds to scroll progress of RocketStorySection.
---

<!-- Fixed canvas layer behind the rocket story. -->
<div class="rocket-bg js-rocket-bg">
  <div class="rocket-bg__container js-rocket-container">
    <canvas
      class="rocket-bg__canvas js-rocket-canvas"
      width="1400"
      height="1400"></canvas>
  </div>
  <!-- Host for the scrubbed video, when the device proves it can decode one.
       It is never seen: frames are drawn into the canvas above. -->
  <div class="rocket-bg__video-mount js-rocket-video-mount" aria-hidden="true">
  </div>
</div>

<style lang="scss">
  /* Fixed background layer, only visible during the rocket section. */
  .rocket-bg {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    background: #000;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.3s ease;

    &.is-active {
      opacity: 1;
    }
  }

  .rocket-bg__container {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: transform;
    transform-origin: 50% 50%;
  }

  .rocket-bg__canvas {
    display: block;
    max-width: 60vw;
    max-height: 80vh;
    width: auto;
    height: auto;

    @media (max-width: 576px) {
      max-width: 92vw;
      max-height: 65vh;
    }
  }

  /* The video is a decode source, not a visual. It still has to be laid out
     and non-hidden, because iOS skips decoding for display:none /
     visibility:hidden / opacity:0 media. 1x1 at 0.01 alpha satisfies it
     without being visible. */
  .rocket-bg__video-mount {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0.01;
    pointer-events: none;

    :global(video) {
      width: 1px;
      height: 1px;
    }
  }
</style>

<script>
  /**
   * Rocket background frame renderer.
   * Updates based on progress passed from the parent scroll handler, and
   * activates the background only during the rocket section scroll.
   *
   * Frames come from one of two sources. The video is preferred because it
   * holds a handful of decoded frames instead of 240; the JPG sequence is the
   * fallback and is byte-for-byte the behaviour this component always had.
   * The choice is made by probing the decoder, not by reading the user agent.
   */
  import {
    createJpgSource,
    createVideoSource,
    probeVideo,
    TOTAL_FRAMES,
    type RocketFrameSource,
  } from "../utils/rocketFrameSource";

  (function initRocketBg() {
    const canvas = document.querySelector(
      ".js-rocket-canvas",
    ) as HTMLCanvasElement;
    const bg = document.querySelector(".js-rocket-bg") as HTMLElement;
    const videoMount = document.querySelector(
      ".js-rocket-video-mount",
    ) as HTMLElement;
    if (!canvas || !bg) return;

    const ctx = canvas.getContext("2d")!;
    const VIDEO_SRC = "/1/rocket.mp4";

    let source: RocketFrameSource | null = null;
    let lastFrameIdx = -1;

    /* Update the displayed frame from scroll progress. */
    window.updateRocketFrame = function (progress: number) {
      const frameIdx = Math.min(
        TOTAL_FRAMES - 1,
        Math.round(progress * (TOTAL_FRAMES - 1)),
      );
      if (frameIdx !== lastFrameIdx) {
        lastFrameIdx = frameIdx;
        source?.show(frameIdx);
      }

      // Toggle background visibility based on progress
      // Keep visible once started (don't fade out at end)
      if (progress > 0) {
        bg.classList.add("is-active");
      } else {
        bg.classList.remove("is-active");
      }
    };

    /* Adopt whichever source won, and catch it up to the current scroll. */
    function useSource(next: RocketFrameSource) {
      source = next;
      window.__rocketFrameSource = next.kind;
      next.show(lastFrameIdx === -1 ? 0 : lastFrameIdx);
    }

    /* Hand over to the JPG sequence if the decoder dies mid-session. */
    function fallBackToJpg(reason: string) {
      if (source?.kind !== "video") return;
      source.destroy();
      window.__rocketVideoFellBack = reason;
      // lastFrameIdx is preserved, so the sequence resumes where it was
      // instead of snapping back to frame 0.
      useSource(createJpgSource(canvas, ctx));
    }

    // The probe's warm-up seek is the first decode, so the first user-driven
    // scrub is never paying for a cold decoder. Both numbers are published for
    // the harness to assert on.
    probeVideo(VIDEO_SRC, videoMount ?? bg)
      .then((result) => {
        window.__rocketVideoProbe = {
          ok: Boolean(result.video),
          reason: result.reason,
          warmupMs: +result.warmupMs.toFixed(1),
          secondSeekMs: +result.secondSeekMs.toFixed(1),
        };
        if (result.video) {
          useSource(
            createVideoSource(result.video, canvas, ctx, fallBackToJpg),
          );
        } else {
          useSource(createJpgSource(canvas, ctx));
        }
      })
      .catch(() => {
        window.__rocketVideoProbe = {
          ok: false,
          reason: "probe threw",
          warmupMs: -1,
          secondSeekMs: -1,
        };
        useSource(createJpgSource(canvas, ctx));
      });
  })();
</script>
