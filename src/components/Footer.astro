---
import { site } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="footer wrap mono">
  <p>© {year} {site.name}</p>
  <p>Set in Editorial New and Fraktion Mono. Built with Astro.</p>
  <p>{site.place}</p>
</footer>

<style lang="scss">
  .footer {
    display: flex;
    justify-content: space-between;
    gap: var(--gap);
    padding-block: 2rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);

    @include mq(sm) {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
