---
import { projects } from "../data/projects";
import GlassFilter from "../components/GlassFilter.astro";
import "../styles/global.scss";

/**
 * The shell every case page shares: one bar at the top (back to the work,
 * this project's name, the neighbours), the page's own composition in the
 * slot, and the next project at the end.
 *
 * The pages differ in composition, not in system (docs/portfolio-v4-design.md):
 * same type scale, same grid, same components from src/components/case/.
 * No smooth scroll here: a case page is for reading, and the platform's own
 * scroll is the right weight for that. Reveals are one-shot (case.ts).
 *
 * `theme` picks the ground: "light" (white, near-black ink) or "dark" (the
 * space black the home ends its work section on).
 */
interface Props {
  slug: string;
  title: string;
  description: string;
  theme?: "light" | "dark";
  /** A 1200x630 share card, when the project has one. */
  shareCard?: string;
}

const { slug, title, description, theme = "light", shareCard } = Astro.props;
const index = projects.findIndex((p) => p.slug === slug);
const project = projects[index];
const next = projects[(index + 1) % projects.length];
const prev = projects[(index - 1 + projects.length) % projects.length];
---

<!doctype html>
<html lang="en" class:list={["theme-anime", "case-page", `case-page--${theme}`]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Jakhangir Tynshimov</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${title} — Jakhangir Tynshimov`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      shareCard && (
        <>
          <meta property="og:image" content={new URL(shareCard, Astro.site)} />
          <meta name="twitter:image" content={new URL(shareCard, Astro.site)} />
        </>
      )
    }
    <meta name="theme-color" content={theme === "dark" ? "#08080a" : "#ffffff"} />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
  </head>

  <body>
    <GlassFilter />
    <header class="case-bar">
      <a class="case-bar__back" id="js-back-to-works" href="/#work">← All work</a>
      <p class="case-bar__title">{project.title}</p>
      <nav class="case-bar__nav" aria-label="Projects">
        <a href={prev.href} rel="prev" aria-label={`Previous project: ${prev.title}`}><span aria-hidden="true">←</span> <span class="case-bar__label" aria-hidden="true">{prev.title}</span></a>
        <a href={next.href} rel="next" aria-label={`Next project: ${next.title}`}><span class="case-bar__label" aria-hidden="true">{next.title}</span> <span aria-hidden="true">→</span></a>
      </nav>
    </header>

    <main class="case-main">
      <slot />
    </main>

    <aside class="case-next" aria-label="Next project">
      <a class="case-next__link" href={next.href}>
        <span class="case-next__label">Next project</span>
        <span class="case-next__title">{next.title}</span>
        <span class="case-next__line">{next.line}</span>
        <span class="case-next__media">
          <img src={next.cover.src} srcset={next.cover.srcset} sizes="(max-width: 48em) 90vw, 40vw" alt="" width={next.cover.width} height={next.cover.height} loading="lazy" decoding="async" style={`object-position:${next.cover.focal}`} />
        </span>
      </a>
      <footer class="case-foot">
        <a href="/#contact">tynshimj@oregonstate.edu</a>
        <span>© {new Date().getFullYear()} Jakhangir Tynshimov</span>
      </footer>
    </aside>

    <script>
      import { initCase } from "../utils/case";
      import { initPlayers } from "../utils/player";
      initCase();
      initPlayers();
    </script>
  </body>
</html>

<style lang="scss" is:global>
  @use "../styles/helpers/colors" as *;
  @use "../styles/helpers/fonts" as *;
  @use "../styles/helpers/glass" as *;

  /* The case system. Grounds and inks first, so every component below can
     use the two tokens and work on either theme. */
  .case-page {
    --case-ground: #ffffff;
    --case-ink: #0b0b0c;
    /* 8.8:1 on white: captions and labels clear the 7:1 the body text gets. */
    --case-soft: #4a4a4f;
    --case-rule: #e2e2e4;
    --case-surface: #f6f5f2;
    --case-accent: #e00538;
    --case-measure: 64ch;
    --case-gutter: clamp(16px, 4vw, 64px);
    background: var(--case-ground);
    color: var(--case-ink);
  }

  .case-page--dark {
    --case-ground: #08080a;
    --case-ink: #ecebef;
    --case-soft: #9a9aa3;
    --case-rule: #26262a;
    --case-surface: #0e0e10;
    --case-accent: #ff4d6d;
  }

  .case-page body {
    margin: 0;
    background: var(--case-ground);
    color: var(--case-ink);
    font: 400 1.0625rem / 1.6 font-family(geist);
    -webkit-font-smoothing: antialiased;
  }

  .case-page :focus-visible {
    outline: 2px solid var(--case-accent);
    outline-offset: 3px;
  }

  /* The bar is three pills of liquid glass floating over the page (the
     owner, 2026-10-03), not a full-width band: the glass is small, and the
     page shows between the pills. The band itself paints nothing and lets
     the pointer through. */
  .case-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem var(--case-gutter);
    font: 400 0.75rem / 1 font-family(fraktion);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    pointer-events: none;

    a {
      color: inherit;
      text-decoration: none;

      &:hover,
      &:focus-visible {
        color: var(--case-accent);
      }
    }
  }

  .case-bar__back,
  .case-bar__title,
  .case-bar__nav {
    @include glass(light, true);
    border-radius: 999px;
    padding: 0.75rem 1.1rem;
    pointer-events: auto;
  }

  .case-page--dark {
    .case-bar__back,
    .case-bar__title,
    .case-bar__nav {
      @include glass(dark, true);
    }
  }

  .case-bar__back {
    justify-self: start;
  }

  .case-bar__title {
    margin: 0;
    color: var(--case-soft);
  }

  .case-bar__nav {
    display: flex;
    justify-self: end;
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .case-bar {
      grid-template-columns: 1fr auto;
    }

    .case-bar__label,
    .case-bar__title {
      display: none;
    }
  }

  .case-main {
    display: block;
  }

  /* Shared type. Titles in Bigger Display, ledes in Editorial New, prose in
     Geist at a reading measure, labels in Fraktion Mono. */
  .case-title {
    margin: 0;
    font: 400 clamp(3.5rem, 10vw, 10.5rem) / 0.86 font-family(bigger);
    text-transform: uppercase;
    letter-spacing: 0.005em;
  }

  .case-lede {
    margin: 0;
    max-width: 34ch;
    font: 400 clamp(1.4rem, 2.1vw, 1.9rem) / 1.3 font-family(editorial);
  }

  .case-label {
    margin: 0;
    font: 400 0.75rem / 1.3 font-family(fraktion);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--case-soft);
  }

  .case-h2 {
    margin: 0 0 1rem;
    font: 400 clamp(2.2rem, 4.6vw, 4.6rem) / 0.92 font-family(bigger);
    text-transform: uppercase;
  }

  /* A mono label over a display heading: the heading's tight line-height
     would otherwise let the two touch. */
  .case-label + .case-h2,
  .case-label + .case-title {
    margin-top: 0.75rem;
  }

  .case-h3 {
    margin: 0 0 0.6rem;
    font: 400 clamp(1.4rem, 2vw, 1.9rem) / 1.15 font-family(editorial);
  }

  .case-prose {
    max-width: var(--case-measure);

    p {
      margin: 0 0 1.1em;
    }

    a {
      color: inherit;
      text-decoration-color: var(--case-accent);
      text-underline-offset: 0.2em;
    }
  }

  .case-section {
    padding: clamp(4rem, 12vh, 9rem) var(--case-gutter);
  }

  .case-award {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--case-rule);
    border-radius: 999px;
    font: 400 0.75rem / 1.2 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;

    &::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--case-accent);
    }
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;

    a {
      display: inline-flex;
      gap: 0.4rem;
      padding: 0.65rem 1rem;
      border: 1px solid var(--case-rule);
      border-radius: 999px;
      color: inherit;
      font: 400 0.8125rem / 1 font-family(geist);
      text-decoration: none;
      transition: border-color 200ms ease;

      &:hover,
      &:focus-visible {
        border-color: var(--case-accent);
      }
    }
  }

  /* One-shot reveal: hidden only once case.ts runs. */
  .js-case [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 700ms ease,
      transform 800ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .js-case [data-reveal].is-in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .js-case [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* The next project, as the page's last screen. */
  .case-next {
    padding: clamp(4rem, 12vh, 8rem) var(--case-gutter) 2rem;
    border-top: 1px solid var(--case-rule);
  }

  .case-next__link {
    display: grid;
    grid-template-columns: 1fr minmax(0, 0.8fr);
    grid-template-areas:
      "label media"
      "title media"
      "line media";
    align-items: end;
    gap: 0.5rem 3rem;
    color: inherit;
    text-decoration: none;

    @media (max-width: 760px) {
      grid-template-columns: 1fr;
      grid-template-areas: "label" "title" "line" "media";
    }
  }

  .case-next__label {
    grid-area: label;
    font: 400 0.75rem / 1 font-family(fraktion);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--case-soft);
  }

  .case-next__title {
    grid-area: title;
    margin-top: 0.5rem;
    font: 400 clamp(3rem, 9vw, 8.5rem) / 0.86 font-family(bigger);
    text-transform: uppercase;
    transition: color 200ms ease;
  }

  .case-next__link:hover .case-next__title,
  .case-next__link:focus-visible .case-next__title {
    color: var(--case-accent);
  }

  .case-next__line {
    grid-area: line;
    max-width: 44ch;
    color: var(--case-soft);
  }

  .case-next__media {
    grid-area: media;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 14px;
    background: var(--case-surface);

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scale(1.04);
      transition: transform 900ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
  }

  .case-next__link:hover .case-next__media img {
    transform: scale(1);
  }

  .case-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(3rem, 8vh, 5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--case-rule);
    font: 400 0.6875rem / 1 font-family(fraktion);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--case-soft);

    a {
      color: inherit;
    }
  }
</style>
