---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import CaseLayout from "../../layouts/CaseLayout.astro";
import CaseMeta from "../../components/case/CaseMeta.astro";
import CaseFigure from "../../components/case/CaseFigure.astro";
import { projects } from "../../data/projects";

/**
 * Zyp, "The live artefact" (docs/portfolio-v4-design.md) told as the
 * internship it was (the owner, 2026-10-06: numbers and process, nothing
 * internal). The page opens on the website itself: the hero sequence of
 * www.zyp.co, the site's own frames, scrubbed by the scroll inside a browser
 * frame (src/utils/frameSequence.ts), with "See it live" as the first thing
 * to press. Then the brief he was given, the four weeks in stages, how the
 * hero was made, the globe, the rest of the page, what was measured, how
 * the work ran, and what he learned.
 *
 * The stage is a runway of 250svh with the frame sticky inside it, and the
 * scroll across it is the playhead, from the first scroll to where the
 * frame lets go. At phone width and under reduced motion there is no
 * runway: the frame holds the sequence's first frame, and no other frame
 * is requested.
 *
 * Signature: the frame lands once, on load, from a tilt (rotateX 12deg,
 * scale 0.9) to flat. Transform only, laid out at its final size so the
 * scale approaches 1 from below and only ever downsamples (invariant 7), and
 * none under reduced motion.
 *
 * Facts: the signed offer letter (Frontend Engineer Intern, part-time,
 * remote, August 2026; "software engineer intern" on the site, the owner's
 * word, 2026-10-06, as is the product team beside him); the repository's history (first commit 16 August,
 * launch 13 September, last merge 19 September 2026; 510 commits, 67 of 68
 * pull requests, 36 stages); its own measurements (Lighthouse on a local
 * preview, the Playwright suite, the decode-window and scrub benches); the
 * public site, captured 2 and 6 October 2026. Nothing internal: no
 * repository link, no customer names, no numbers about the company.
 */
const p = projects.find((x) => x.slug === "zyp")!;
const live = p.links[0].href;

/* The hero sequence's frames, with their count and size, as
   scripts/zyp-frames.mjs wrote them. */
const frameDir = "/projects/zyp/frames";
const seq: { count: number; width: number; height: number } = JSON.parse(readFileSync(join(process.cwd(), "public", frameDir, "frames.json"), "utf8"));
/* One pattern names the frames: the sequence reads it from data-frames
   (frameSequence.ts expands %04d the same way), the strip below expands it. */
const PATTERN = `${frameDir}/frame_%04d.webp`;
const frame = (n: number) => PATTERN.replace("%04d", String(n).padStart(4, "0"));
/* Six of the shipped frames, evenly along the move, for the process strip. */
const strip = [1, 20, 40, 60, 80, seq.count];
const ticks = Array.from({ length: seq.count }, (_, i) => ({ x: i + 0.5, major: i === 0 || (i + 1) % 10 === 0 }));

const parts = [
  { id: "brief", kind: "The brief", title: "One job for the page" },
  { id: "weeks", kind: "Four weeks", title: "From first commit to launch" },
  { id: "hero", kind: "Motion", title: "How the hero was made" },
  { id: "globe", kind: "3D", title: "The canvas globe" },
  { id: "rest", kind: "The page", title: "The rest of it" },
  { id: "measured", kind: "Measured", title: "What the numbers said" },
  { id: "process", kind: "Process", title: "How the work ran" },
];

/* The rules written before the first line of motion code. */
const rules = [
  "One animation loop on the page, and it idles at 0 Hz when nothing subscribes.",
  "GSAP writes numbers into shared state; the renderers draw on their own tick.",
  "Exactly one pinned scroll trigger. Reveals are opacity and transform, 200–400 ms.",
  "No scroll hijacking and no smooth-scroll library: the scroll is the reader's.",
  "The headline and Book a Demo render on first paint, never behind a loader or an animation.",
  "Under 768 px and under reduced motion, a photograph: zero animation bytes.",
];

/* The weeks, from the repository's own dates. */
const weeks = [
  { d: "Aug 16", t: "Scaffold", s: "Astro 7, every section's real copy, the motion manager, the first scroll-driven sequence on placeholder frames." },
  { d: "Aug 22", t: "Real frames", s: "The responsive AVIF and WebP frame pipeline; decoded-frame memory bounded to a sliding window." },
  { d: "Sep 4", t: "The dive", s: "Production frames, the product-video takeover at the end of the hero, the lower page, the first accessibility pass." },
  { d: "Sep 5", t: "The stutter", s: "A scroll stutter traced to decode starvation; a direction-aware, byte-budgeted decode window and a WebP scrub path." },
  { d: "Sep 6", t: "Fifteen pull requests", s: "The liquid-glass header, the studio theme, the canvas globe, the Playwright suite with axe, in one day." },
  { d: "Sep 13", t: "Launch", s: "The production origin set to www.zyp.co and the build cut from 21 pages to 9." },
  { d: "Sep 19", t: "Last pass", s: "The loader, the Trusted-by cylinder, the films and the look, after a client call." },
];

/* How the hero was made, in five steps. */
const making = [
  { t: "One photograph", s: "The office, shot once. The hero needed a camera move the photograph did not have." },
  { t: "A camera move", s: "A generated push-in from the room to the laptop: steady, one direction, the screen blank, the last frame frontal with the screen full-bleed." },
  { t: "192 frames", s: "The take cut to frames with ffmpeg, then resampled to the 97 that ship, so the sequence spans the whole move." },
  { t: "The screen, tracked", s: "OpenCV finds the laptop's screen on frame one and follows it through the take with a sub-pixel fit, 0.27 px of jitter at the 90th percentile, and warps the live dashboard onto it." },
  { t: "A decode window", s: "The frames decode a few ahead of the scroll in the direction it is going, inside a byte budget: peak decoded memory went from 995 MB to 149 MB." },
];

/* Measured by the repository's own tools, September 2026. */
const measured = [
  { label: "Lighthouse, desktop", value: "100 · 100 · 100 · 100 (performance, accessibility, best practices, SEO)" },
  { label: "Lighthouse, mobile", value: "98 · 100 · 100 · 100; LCP 2.2 s, CLS 0" },
  { label: "Largest paint, desktop", value: "0.7 s, total blocking time 0 ms" },
  { label: "Decoded frames in memory", value: "peak 995 MB → 149 MB" },
  { label: "Held frames at medium wheel speed", value: "69–83% of draws → 0–1%" },
  { label: "End-to-end tests", value: "128 per engine in Chromium, WebKit and a mobile profile; 0 failures at the last gate" },
  { label: "Accessibility", value: "axe: 0 violations on 5 routes; 21 colour pairs at AA" },
  { label: "Phones", value: "hero photograph ≤ 50 KB, 0 bytes of sequence" },
];
---

<CaseLayout slug="zyp" title="Zyp internship" description={p.line} shareCard="/projects/zyp/og.jpg">
  <div class="zyp">
    <header class="zyp-hero">
      <div class="zyp-hero__top">
        <div class="zyp-hero__name">
          <p class="case-label">{p.kind} · {p.where} · {p.when}</p>
          <h1 class="case-title">Zyp</h1>
        </div>
        <div class="zyp-hero__aside">
          <p class="case-lede">Zyp's public website, built and launched in four weeks: a hero you scrub with the scroll, a globe drawn on a canvas, and the tests that let it keep changing.</p>
          <a class="zyp-live" href={live} target="_blank" rel="noopener noreferrer">See it live <span class="zyp-live__arrow" aria-hidden="true">↗</span><span class="u-sr-only">(opens in a new tab)</span></a>
        </div>
      </div>

      <div class="zyp-stage js-frame-seq-runway">
        <div class="zyp-stage__pin">
          <figure class="zyp-browser">
            <div class="zyp-browser__window">
              <div class="zyp-browser__bar" aria-hidden="true">
                <span class="zyp-browser__dots"><i></i><i></i><i></i></span>
                <span class="zyp-browser__url">
                  <svg viewBox="0 0 10 12"><rect x="1" y="5" width="8" height="6.5" rx="1.2" /><path d="M3 5V3.6a2 2 0 0 1 4 0V5" /></svg>
                  zyp.co
                </span>
              </div>
              <div class="zyp-browser__view js-frame-seq" data-frames={PATTERN} data-count={seq.count} style={`aspect-ratio:${seq.width} / ${seq.height}`}>
                <img
                  src={frame(1)}
                  width={seq.width}
                  height={seq.height}
                  alt="The first frame of the zyp.co hero: an open-plan office, with a laptop on a white desk by the window and people working at the desks behind"
                  fetchpriority="high"
                  decoding="async"
                />
              </div>
            </div>
            <figcaption>
              <span class="zyp-cap zyp-cap--live">The hero of www.zyp.co, played by your scroll as it is on the site: the shot moves in from the office to the laptop.</span>
              <span class="zyp-cap zyp-cap--still">The first frame of the hero on www.zyp.co. On the site, the scroll moves the shot in from the office to the laptop.</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </header>

    <section class="zyp-details" aria-label="Details">
      <CaseMeta
        rows={[
          { label: "Role", value: "Software engineer intern, Zyp, Inc. (remote, part-time)" },
          { label: "My part", value: "The whole public site: motion, 3D, the media pipelines, the tests" },
          { label: "When", value: "August 2026; the site launched 13 September, my last pass 19 September" },
          { label: "Stack", value: "Astro 7, TypeScript, GSAP, Canvas 2D, Playwright + axe, ffmpeg, OpenCV" },
        ]}
      />
    </section>

    <section class="case-section zyp-intro">
      <div class="zyp-intro__grid">
        <div>
          <p class="case-label" data-reveal>The site</p>
          <div class="case-prose zyp-intro__prose" data-reveal>
            <p>In August 2026 I joined Zyp, a company that moves money across borders for outsourcing businesses, to build its public site, www.zyp.co.</p>
            <p>Zyp's product team builds the platform itself; the public site was my part. It went from an empty repository on 16 August to production on 13 September, and I kept shipping for a week after. Seven parts follow, each named for what it is.</p>
          </div>
        </div>
        <ol class="zyp-index" data-reveal>
          {parts.map((part) => (
            <li>
              <a href={`#${part.id}`}>
                <span class="zyp-index__t">{part.title}</span>
                <span class="zyp-index__k">{part.kind}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id={parts[0].id} class="case-section zyp-part zyp-part--ruled">
      <div class="zyp-split zyp-split--even">
        <div class="zyp-split__text">
          <p class="zyp-tag" data-reveal>{parts[0].kind}</p>
          <h2 class="case-h2" data-reveal>{parts[0].title}</h2>
          <div class="case-prose" data-reveal>
            <p>The page has one thing to do: get a visitor to book a demo. The visitors run outsourcing, staffing and consulting businesses that pay people across borders. They evaluate the site before they ever speak to anyone, often forward it to a partner who arrives with no context, and a good share of them arrive on a phone. Zyp moves their money, so the page has to read as trustworthy before it reads as clever.</p>
            <p>So the motion supports the content and never competes with it. Before the first line of animation I wrote the rules the whole build was reviewed against, thirteen of them. These six did the most work.</p>
          </div>
        </div>
        <ol class="zyp-rules" data-reveal>
          {rules.map((r) => <li>{r}</li>)}
        </ol>
      </div>
    </section>

    <section id={parts[1].id} class="case-section zyp-part zyp-part--ground">
      <div class="zyp-weeks__head">
        <div>
          <p class="zyp-tag" data-reveal>{parts[1].kind}</p>
          <h2 class="case-h2" data-reveal>{parts[1].title}</h2>
        </div>
        <dl class="zyp-counts" data-reveal>
          <div><dt>Stages</dt><dd>36</dd></div>
          <div><dt>Pull requests</dt><dd>67</dd></div>
          <div><dt>Commits</dt><dd>510</dd></div>
          <div><dt>Days to launch</dt><dd>28</dd></div>
        </dl>
      </div>
      <ol class="zyp-weeks" data-reveal>
        {weeks.map((w) => (
          <li>
            <time>{w.d}</time>
            <strong>{w.t}</strong>
            <span>{w.s}</span>
          </li>
        ))}
      </ol>
    </section>

    <section id={parts[2].id} class="case-section zyp-part">
      <div class="zyp-scrub__head">
        <div>
          <p class="zyp-tag" data-reveal>{parts[2].kind}</p>
          <h2 class="case-h2" data-reveal>{parts[2].title}</h2>
        </div>
        <div class="case-prose" data-reveal>
          <p>The home page opens on an office, and the scroll is the playhead: reading down pushes the shot in from the room to the laptop on the desk, scrolling back up plays it in reverse, and at the end the laptop's screen becomes the product video. The reader sets the pace. Getting there was a pipeline, not a video file.</p>
        </div>
      </div>

      <ol class="zyp-making" data-reveal>
        {making.map((m) => (
          <li>
            <strong>{m.t}</strong>
            <span>{m.s}</span>
          </li>
        ))}
      </ol>

      <div class="zyp-ruler" aria-hidden="true" data-reveal>
        <svg viewBox={`0 0 ${seq.count} 10`} preserveAspectRatio="none">
          {ticks.map((t) => <line x1={t.x} x2={t.x} y1={t.major ? 0 : 5} y2="10" class={t.major ? "is-major" : undefined} />)}
          <line x1="0.5" x2="0.5" y1="0" y2="10" class="is-head" />
        </svg>
        <p><span>Frame 1</span><span class="zyp-ruler__mid">{seq.count} frames, one scroll</span><span>{seq.count}</span></p>
      </div>

      <figure class="zyp-strip" data-reveal>
        <ol class="zyp-strip__frames">
          {strip.map((n) => (
            <li>
              <img src={frame(n)} width={seq.width} height={seq.height} alt={`Frame ${n} of ${seq.count} of the zyp.co hero`} loading="lazy" decoding="async" />
              <span>{n}</span>
            </li>
          ))}
        </ol>
        <figcaption>Six of the {seq.count} shipped frames: the room, the approach, the laptop with the dashboard composited onto its screen.</figcaption>
      </figure>
    </section>

    <section id={parts[3].id} class="case-section zyp-part zyp-part--ground">
      <div class="zyp-split zyp-split--media-first">
        <div class="zyp-split__text">
          <p class="zyp-tag" data-reveal>{parts[3].kind}</p>
          <h2 class="case-h2" data-reveal>{parts[3].title}</h2>
          <div class="case-prose" data-reveal>
            <p>Under the heading “Coverage where it matters”, the page draws a globe on an HTML canvas: no WebGL, no 3D library. The land comes from Natural Earth through d3-geo at build time and is drawn as dots in depth buckets; the payment arcs lift off the surface and are hidden where the sphere is in the way; a drag turns it. A frame draws in about 1.3 ms, and the globe mounts only when it is near the screen.</p>
          </div>
        </div>
        <CaseFigure slug="zyp" id="globe" alt="The section 'Coverage where it matters' on www.zyp.co: a pale globe with its land drawn as a field of dots" caption="“Coverage where it matters”, captured 6 October 2026." sizes="(max-width: 56em) 100vw, 56vw" class="zyp-split__media" />
      </div>
    </section>

    <section id={parts[4].id} class="case-section zyp-part zyp-part--ruled">
      <div class="zyp-scrub__head">
        <div>
          <p class="zyp-tag" data-reveal>{parts[4].kind}</p>
          <h2 class="case-h2" data-reveal>{parts[4].title}</h2>
        </div>
        <div class="case-prose" data-reveal>
          <p>Everything below the hero is the same idea at a smaller scale: a little motion that explains, then stillness. The header is glass at rest and a solid surface the moment the page scrolls, which is what fixed its jank. The logos turn on a cylinder made of CSS transforms. The dashboard band counts up once. The films open at full size with a transport under them.</p>
        </div>
      </div>
      <div class="zyp-rest">
          <CaseFigure slug="zyp" id="header" alt="The top of www.zyp.co: the Zyp mark, a glass pill with Businesses, Freelancers and People, and the Book a demo button, over the blurred office" caption="The header: liquid glass at rest." sizes="100vw" class="zyp-rest__wide" />
          <CaseFigure slug="zyp" id="trusted" alt="Under the hero on www.zyp.co: a row of client logos, 'Trusted by growing teams worldwide', and the statement 'Payments, payroll and paperwork for global teams.'" caption="The Trusted-by cylinder and the statement." sizes="(max-width: 56em) 100vw, 46vw" />
          <CaseFigure slug="zyp" id="tablet" alt="The dashboard band on www.zyp.co: a tablet showing a balance chart, cash flow and payroll due" caption="The dashboard band: it plays itself once." sizes="(max-width: 56em) 100vw, 46vw" />
          <CaseFigure slug="zyp" id="films" alt="The Clients section on www.zyp.co: a dark product window with a transport under it beside the heading 'Clients'" caption="A film in its window, with its transport." sizes="(max-width: 56em) 100vw, 46vw" />
          <CaseFigure slug="zyp" id="g03" alt="The Team section of www.zyp.co: a dark product window with playback controls under it, beside the heading 'Team'" caption="The Team section, captured 2 October." sizes="(max-width: 56em) 100vw, 46vw" />
      </div>
    </section>

    <section id={parts[5].id} class="case-section zyp-part zyp-part--ground">
      <div class="zyp-split zyp-split--even">
        <div class="zyp-split__text">
          <p class="zyp-tag" data-reveal>{parts[5].kind}</p>
          <h2 class="case-h2" data-reveal>{parts[5].title}</h2>
          <div class="case-prose" data-reveal>
            <p>Every claim about the page's speed came from a tool, not a feeling. The scroll stutter was found by tracing: the renderer was starving for decoded frames, 38 misses in 54 ticks, with image decode the top cost in every run. The fix was measured on a scrub bench, and the budgets were written down so the next change had something to be held to.</p>
            <p class="zyp-measured__note">Lighthouse ran on a local preview build; the frame and memory numbers are from headless Chromium on a four-core machine, for comparison with each other.</p>
          </div>
        </div>
        <CaseMeta class="zyp-measured" rows={measured} />
      </div>
    </section>

    <section id={parts[6].id} class="case-section zyp-part">
      <div class="zyp-split zyp-split--even">
        <div class="zyp-split__text">
          <p class="zyp-tag" data-reveal>{parts[6].kind}</p>
          <h2 class="case-h2" data-reveal>{parts[6].title}</h2>
        </div>
        <div class="case-prose" data-reveal>
          <p>Every stage started as a written brief: the goal, what was in and out of scope, the rules that applied, the edge cases on phones and under reduced motion, and how it would be verified. I ran the implementation of those briefs through coding agents and reviewed every diff myself against the thirteen rules; the architecture, the diagnosis and every merge were mine.</p>
          <p>Nothing that touched the pinned hero or the scroll merged without the Safari gate: the build on my own iPhone, in real Safari, scrolled fast and slow with the address bar collapsing and returning. A headless browser never caught what that did.</p>
          <p>The company's side ran as a written request log, each item with what it unblocked; a call became a pull request; a change proposed from their side was reviewed, used as the spec, and rebuilt on the production base.</p>
        </div>
      </div>
    </section>

    <section class="case-section zyp-learned">
      <div class="zyp-learned__grid">
        <h2 class="case-h2" data-reveal>What I learned</h2>
        <div>
          <div class="case-prose" data-reveal>
            <p>People come to a company's public site for the product, not for the effects. Motion there has to carry the message and then step aside, so the interesting decisions were about what moves, how far and when, more than how. The rest was discipline: write the rules first, measure before claiming, and test on the one device that matters before merging.</p>
          </div>
          <aside class="zyp-note" data-reveal>
            <p class="case-label">A note on the captures</p>
            <p>The pictures on this page were captured from the public site on 2 and 6 October 2026, and the sequence at the top is the site's own frames. The live site may have changed since.</p>
          </aside>
          <a class="zyp-live" href={live} target="_blank" rel="noopener noreferrer" data-reveal>See it live <span class="zyp-live__arrow" aria-hidden="true">↗</span><span class="u-sr-only">(opens in a new tab)</span></a>
        </div>
      </div>
    </section>
  </div>
</CaseLayout>

<script>
  import { initFrameSequences } from "../../utils/frameSequence";
  initFrameSequences();
</script>

<style lang="scss">
  @use "../../styles/helpers/fonts" as *;

  /* The hero: the name and the first action, then the site in its frame. */
  .zyp-hero__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
    padding: clamp(2.5rem, 7vh, 5rem) var(--case-gutter) clamp(2rem, 5vh, 3.5rem);

    @media (max-width: 56em) {
      grid-template-columns: 1fr;
    }

    /* Three letters: the name can be larger than the shared scale, and the
       display face's caps rise above its tight line box, so the label above
       needs more room than a margin of 1rem gives it. */
    .case-title {
      margin-top: clamp(1.5rem, 2.6vw, 2.5rem);
      font-size: clamp(5.5rem, 16vw, 13rem);
    }
  }

  .zyp-hero__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .zyp-live {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.95rem 1.4rem;
    border-radius: 999px;
    background: var(--case-ink);
    color: #fff;
    font: 500 0.9375rem / 1 font-family(geist);
    text-decoration: none;

    &:hover,
    &:focus-visible {
      background: var(--case-accent);
    }
  }

  .zyp-live__arrow {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .zyp-live__arrow {
      transition: transform 200ms ease;
    }

    .zyp-live:hover .zyp-live__arrow,
    .zyp-live:focus-visible .zyp-live__arrow {
      transform: translate(2px, -2px);
    }
  }

  /* The frame sits half on the white and half on the warm ground, which the
     details then continue. */
  .zyp-stage {
    padding: 0 var(--case-gutter) clamp(1.25rem, 3vh, 2rem);
    background: linear-gradient(to bottom, transparent 0 46%, var(--case-surface) 46%);
  }

  .zyp-browser {
    max-width: 72rem;
    margin: 0 auto;

    figcaption {
      margin-top: 0.8rem;
      font: 400 0.8125rem / 1.45 font-family(geist);
      color: var(--case-soft);
    }
  }

  .zyp-cap--live {
    display: none;
  }

  /* The runway the sequence plays across: the same query as LIVE in
     frameSequence.ts, which plays nothing outside it. The frame holds the
     middle of the screen, clear of the case bar's pills, and is never
     taller than the screen. The warm ground rises behind it as it plays and
     reaches its middle as it lets go, where the details carry it on. */
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .zyp-stage {
      height: 250svh;
      padding-bottom: 0;
      background: linear-gradient(to bottom, transparent 0 calc(100% - 50svh), var(--case-surface) 0);
    }

    .zyp-stage__pin {
      position: sticky;
      top: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: 100svh;
      padding: 4rem 0 1rem;
    }

    .zyp-browser {
      width: min(100%, 72rem, calc((100svh - 10.5rem) * 16 / 9));
    }

    .zyp-cap--live {
      display: inline;
    }

    .zyp-cap--still {
      display: none;
    }
  }

  /* Laid out at its final size: 72rem at most. */
  .zyp-browser__window {
    overflow: hidden;
    border: 1px solid rgba(11, 11, 12, 0.1);
    border-radius: 14px;
    background: #fff;
    box-shadow:
      0 1px 2px rgba(11, 11, 12, 0.05),
      0 30px 70px -32px rgba(11, 11, 12, 0.35);
  }

  /* One-shot, transform only. The layer is promoted while it runs and let go
     when it ends; `backwards` holds the tilt through the short delay, and
     nothing is held after. */
  @media (prefers-reduced-motion: no-preference) {
    .zyp-browser__window {
      animation: zyp-land 1400ms cubic-bezier(0.16, 1, 0.3, 1) 120ms backwards;
    }
