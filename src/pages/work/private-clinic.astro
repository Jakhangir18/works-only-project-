---
import ProjectLayout from "../../components/ProjectLayout.astro";

const downloads = [
  { href: "https://sadapclinic.kz/", label: "Visit sadapclinic.kz" },
];
---

<ProjectLayout
  title="Sadap Clinic"
  number="05"
  accentColor="#a78bfa"
  heroColor="#0e0a18"
  heroImage="/projects/private-clinic/cover.webp"
  intro="Sadap is a multi-speciality clinic in Aktau, Kazakhstan. Its website is the front door to the clinic: patients search for a doctor or a symptom, book an appointment, and prepare for a procedure without calling anyone. Built as a two-person project."
  problem="A private clinic's website is usually a brochure — an address, a phone number, a list of services — and every actual booking still goes through a receptionist on a phone line that is open eight hours a day. That caps the clinic at the number of calls it can answer, and it caps the patient at the hours they can call. It also assumes the patient already knows which speciality they need, which is exactly what a person with a symptom does not know."
  approach="We built the site around the two questions a patient actually arrives with: who should I see, and when can I come. Doctor search sits at the top of the home page rather than behind a menu. A symptom checker and a consultant tool exist for people who cannot name a speciality. Preparation guides — ultrasound, endoscopy, gynaecology — answer the questions that otherwise become phone calls the day before an appointment. Booking runs through a patient account rather than a form, so a returning patient is not retyping their details. The whole site runs in three languages, Kazakh, Russian and English, because the clinic's patients do not share one."
  solution="The live site carries the full clinic: services, a doctors directory, promotions, a Check Up programme, a patients area with the symptom checker and preparation guides, a corporate section for companies buying employee care, vacancies, reviews, contacts, and a personal cabinet with online booking. Language is a first-class switch, not an afterthought — every route exists in all three."
  outcome="The site is live at sadapclinic.kz and is the clinic's booking channel. This page is deliberately narrow about credit: the work was done with a partner, and the split of responsibilities between us is not something this page claims until it can be stated precisely."
  downloads={downloads}
/>
