---
import CaseLayout from "../../layouts/CaseLayout.astro";
import CaseMeta from "../../components/case/CaseMeta.astro";
import CaseFigure from "../../components/case/CaseFigure.astro";
import CaseClip from "../../components/case/CaseClip.astro";
import { projects } from "../../data/projects";

/**
 * SPOOT, "One video, one bearing" (docs/portfolio-v4-design.md): the
 * shortest page, on black. The title sits where the wearer would, inside a
 * bearing dial whose red mark turns to the pointer; one sentence of thesis;
 * why, in two small dials; "How it hears" as three diagrams, one verb each; the
 * one video and the two photographs as one strip; the credits.
 *
 * No photograph shows the glasses, the microphones, the OLED or the phone
 * page, so the device is told in text and drawn as diagrams, and the event
 * pictures stay in the award section where they cannot pass for the
 * product. The walk is kept out of the dial for the same reason: a
 * first-person clip inside the product's own motif would read as footage
 * from the glasses.
 *
 * Facts: the official BeaverHacks project page, the repository README (who
 * built what) and the owner's own account of why.
 */
const p = projects.find((x) => x.slug === "spoot")!;
const demo = p.links.find((l) => l.href.includes("youtube.com"))!;

/* The dial, in a viewBox centred on the wearer: 0° is front, clockwise. */
const R = 192;
const at = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return { x: +(r * Math.sin(a)).toFixed(2), y: +(-r * Math.cos(a)).toFixed(2) };
};
const ticks = Array.from({ length: 72 }, (_, i) => {
  const deg = i * 5;
  const kind = deg % 90 === 0 ? "is-cardinal" : deg % 30 === 0 ? "is-major" : "";
  const inner = kind === "is-cardinal" ? R - 20 : kind === "is-major" ? R - 12 : R - 6;
  return { a: at(deg, inner), b: at(deg, R), kind };
});
const numerals = [30, 60, 120, 150, 210, 240, 300, 330].map((deg) => ({ deg, ...at(deg, R - 32) }));
const arc = (r: number, half: number) => {
  const a = at(-half, r);
  const b = at(half, r);
  return `M ${a.x} ${a.y} A ${r} ${r} 0 0 1 ${b.x} ${b.y}`;
};
/* Where the mark rests before anyone moves: behind, to the right. */
const REST = 135;
/* Word joiners keep "2-3" on one line. */
const DATES = "May 2\u2060-\u20603, 2026";

/* The owner's reason, as two bearings a game would draw. */
const examples = [
  { deg: 90, label: "A car on your right" },
  { deg: 180, label: "Someone calling you from behind" },
];
---

<CaseLayout slug="spoot" title="SPOOT" description={p.line} theme="dark" shareCard="/projects/spoot/og.jpg">
  <header class="sp-hero js-sp-hero">
    <p class="case-label sp-hero__label">{p.kind} · {p.where} · {p.when}</p>

    <div class="sp-hero__dial">
      <div class="sp-dial js-sp-dial">
        <svg class="sp-dial__face" viewBox="-230 -230 460 460" role="img" aria-label="A bearing dial seen from above: the wearer at the centre, front at the top, and a red mark on the ring where a sound came from">
          <circle class="sp-dial__wash" r={R} />
          <circle class="sp-dial__ring" r={R} />
          <circle class="sp-dial__inner" r="128" />
          {ticks.map((t) => <line class:list={["sp-dial__tick", t.kind]} x1={t.a.x} y1={t.a.y} x2={t.b.x} y2={t.b.y} />)}
          <g class="sp-dial__deg">
            {numerals.map((n) => (
              <text x={n.x} y={n.y} dy="0.35em" text-anchor="middle">{String(n.deg).padStart(3, "0")}</text>
            ))}
          </g>
        </svg>
        <div class="sp-dial__mark js-sp-mark" data-rest={REST} style={`transform: rotate(${REST}deg)`} aria-hidden="true">
          <svg viewBox="-230 -230 460 460">
            <line class="sp-mark__path" x1="0" y1="-134" x2="0" y2={-(R - 24)} />
            <path class="sp-mark__arc" d={arc(R + 9, 11)} />
            <path class="sp-mark__bug" d={`M 0 ${-(R - 22)} L -7 ${-(R - 2)} L 7 ${-(R - 2)} Z`} />
          </svg>
        </div>
        <span class="sp-dial__cardinal" style="left:50%; top:3.4%" aria-hidden="true">Front</span>
        <span class="sp-dial__cardinal" style="left:96.6%; top:50%; --turn:90deg" aria-hidden="true">Right</span>
        <span class="sp-dial__cardinal" style="left:50%; top:96.6%" aria-hidden="true">Behind</span>
        <span class="sp-dial__cardinal" style="left:3.4%; top:50%; --turn:-90deg" aria-hidden="true">Left</span>
        <div class="sp-dial__centre">
          <h1 class="case-title">SPOOT</h1>
        </div>
      </div>
      <p class="sp-dial__note">
        The wearer at the centre, front at the top. The red mark is where a sound came from.
        <span class="sp-dial__try sp-dial__try--hover">Move your pointer: it is the sound.</span>
        <span class="sp-dial__try sp-dial__try--touch">Tap near the ring: the tap is the sound.</span>
      </p>
    </div>

    <div class="sp-hero__thesis">
      <p class="case-award">{p.result}</p>
      <p class="case-lede">Glasses that show you where a sound came from.</p>
    </div>

    <CaseMeta
      class="sp-hero__meta"
      rows={[
        { label: "My part", value: "The phone AR layer, the 3D-printed glasses hardware, the Raspberry Pi bring-up" },
        { label: "Team", value: "Carson Secrest, Jakhangir Tynshimov" },
        { label: "Event", value: `BeaverHacks 2026, Oregon State, ${DATES}` },
      ]}
    />
  </header>

  <section class="case-section sp-section sp-why">
    <div class="sp-why__text">
      <p class="case-label" data-reveal>Why</p>
      <h2 class="case-h2" data-reveal>One ear, no direction</h2>
      <p class="sp-why__statement" data-reveal>A friend of ours is deaf in one ear. He cannot tell where a sound is coming from, so he always turns the same way.</p>
    </div>
    <div class="sp-why__side">
      <div class="case-prose" data-reveal>
        <p>The idea is borrowed from video games, which draw a sound on the screen where it is. We wanted the same thing on a pair of glasses.</p>
      </div>
      <ul class="sp-why__dials" data-reveal>
        {examples.map((e) => (
          <li>
            <svg viewBox="-60 -60 120 120" role="img" aria-label={`${e.label}: a bearing of ${e.deg} degrees`}>
              <circle class="sp-mini__ring" r="44" />
              {[0, 90, 180, 270].map((d) => {
                const a = at(d, 38);
                const b = at(d, 44);
                return <line class="sp-mini__tick" x1={a.x} y1={a.y} x2={b.x} y2={b.y} />;
              })}
              <circle class="sp-mini__you" r="3" />
              <g transform={`rotate(${e.deg})`}>
                <line class="sp-mark__path" x1="0" y1="-12" x2="0" y2="-34" />
                <path class="sp-mark__arc" d={arc(50, 16)} />
                <path class="sp-mark__bug" d="M 0 -35 L -5 -45 L 5 -45 Z" />
              </g>
            </svg>
            <span>{e.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="case-section sp-section sp-how">
    <div class="sp-how__head">
      <p class="case-label" data-reveal>Three steps</p>
      <h2 class="case-h2" data-reveal>How it hears</h2>
    </div>

    <ol class="sp-steps">
      <li class="sp-step" data-reveal>
        <p class="sp-step__verb">Hear</p>
        <h3 class="case-h3">Microphones</h3>
        <div class="sp-step__text">
          <p>The 3D-printed glasses come with a reSpeaker XVF3800, a USB array of four microphones, on a Raspberry Pi. On the Pi itself, Silero VAD picks out speech and faster-whisper transcribes it.</p>
          <p>The glasses hardware and the Pi bring-up were my part.</p>
        </div>
        <figure class="sp-step__fig">
          <div class="sp-step__plate">
            <svg viewBox="0 0 240 132" role="img" aria-label="Diagram: sound reaches a four-microphone array, which is connected over USB to a Raspberry Pi running Silero VAD and faster-whisper">
              <g class="sp-d-wave">
                <path d="M 13.66 55.57 A 10 10 0 0 1 13.66 68.43" />
                <path d="M 19.79 50.43 A 18 18 0 0 1 19.79 73.57" />
                <path d="M 25.92 45.28 A 26 26 0 0 1 25.92 78.72" />
              </g>
              <circle class="sp-d-line" cx="72" cy="62" r="26" />
              <g class="sp-d-fill">
                <circle cx="62.1" cy="52.1" r="3.4" />
                <circle cx="81.9" cy="52.1" r="3.4" />
                <circle cx="62.1" cy="71.9" r="3.4" />
                <circle cx="81.9" cy="71.9" r="3.4" />
              </g>
              <text class="sp-d-text" x="72" y="104" text-anchor="middle">4 mics</text>
              <text class="sp-d-text is-soft" x="72" y="116" text-anchor="middle">XVF3800</text>
              <line class="sp-d-line is-soft" x1="98" y1="62" x2="132" y2="62" />
              <text class="sp-d-text is-soft" x="115" y="56" text-anchor="middle">USB</text>
              <rect class="sp-d-line" x="132" y="22" width="100" height="80" rx="6" />
              <text class="sp-d-text" x="182" y="38" text-anchor="middle">Raspberry Pi</text>
              <rect class="sp-d-line is-soft" x="140" y="48" width="84" height="18" rx="3" />
              <text class="sp-d-text" x="182" y="60" text-anchor="middle">Silero VAD</text>
              <rect class="sp-d-line is-soft" x="140" y="74" width="84" height="18" rx="3" />
              <text class="sp-d-text" x="182" y="86" text-anchor="middle">faster-whisper</text>
              <text class="sp-d-text is-soft" x="182" y="118" text-anchor="middle">→ transcript</text>
            </svg>
          </div>
          <figcaption>Diagram. Four microphones in, text out, on the Pi.</figcaption>
        </figure>
      </li>

      <li class="sp-step" data-reveal style="transition-delay: 90ms">
        <p class="sp-step__verb">Ask</p>
        <h3 class="case-h3">Direction</h3>
        <div class="sp-step__text">
          <p>The array's direction-of-arrival reading is mapped to a bearing around the wearer. The transcript, the bearing and the volume go to Gemini Flash, which answers in JSON: how important the sound is, whether it was meant for you, and a message of eight words.</p>
          <p>Carson built the mapping and the Gemini integration in the server.</p>
        </div>
        <figure class="sp-step__fig">
          <div class="sp-step__plate">
            <svg viewBox="0 0 240 132" role="img" aria-label="Diagram: a bearing on a small dial, and Gemini Flash taking the transcript, bearing and volume and returning importance, whether it is directed at you, and an eight-word message">
              <circle class="sp-d-line is-soft" cx="46" cy="60" r="34" />
              {[0, 90, 180, 270].map((d) => {
                const a = at(d, 28);
                const b = at(d, 34);
                return <line class="sp-d-line" x1={46 + a.x} y1={60 + a.y} x2={46 + b.x} y2={60 + b.y} />;
              })}
              <circle class="sp-d-fill" cx="46" cy="60" r="2.6" />
              <g transform="translate(46 60) rotate(120)">
                <line class="sp-mark__path" x1="0" y1="-6" x2="0" y2="-24" />
                <path class="sp-mark__arc" d={arc(39, 16)} />
                <path class="sp-mark__bug" d="M 0 -25 L -4 -33 L 4 -33 Z" />
              </g>
              <text class="sp-d-text" x="46" y="114" text-anchor="middle">Bearing</text>
              <line class="sp-d-line is-soft" x1="86" y1="60" x2="104" y2="60" />
              <path class="sp-d-fill is-soft" d="M 108 60 L 102 56.5 L 102 63.5 Z" />
              <rect class="sp-d-line" x="110" y="10" width="124" height="112" rx="6" />
              <text class="sp-d-text" x="119" y="26">Gemini Flash</text>
              <text class="sp-d-text is-soft" x="119" y="42">In: text, bearing,</text>
              <text class="sp-d-text is-soft" x="119" y="53">volume</text>
              <line class="sp-d-line is-soft is-dash" x1="119" y1="61" x2="225" y2="61" />
              <text class="sp-d-text is-soft" x="119" y="75">Out, as JSON:</text>
              <g class="sp-d-dots">
                <circle cx="122" cy="87.2" r="2" />
                <circle cx="122" cy="100.2" r="2" />
                <circle cx="122" cy="113.2" r="2" />
              </g>
              <text class="sp-d-text" x="129" y="90">importance</text>
              <text class="sp-d-text" x="129" y="103">for you?</text>
              <text class="sp-d-text" x="129" y="116">8-word message</text>
            </svg>
          </div>
          <figcaption>Diagram. A bearing and a transcript in, a three-part answer out.</figcaption>
        </figure>
      </li>

      <li class="sp-step" data-reveal style="transition-delay: 180ms">
        <p class="sp-step__verb">Show</p>
        <h3 class="case-h3">Display</h3>
        <div class="sp-step__text">
          <p>The result shows in two places: on an I2C OLED HUD, and in an AR web app on the phone.</p>
          <p>Carson built the HUD. The phone AR layer was mine.</p>
        </div>
        <figure class="sp-step__fig">
          <div class="sp-step__plate">
            <svg viewBox="0 0 240 132" role="img" aria-label="Diagram: the same result on two screens, a small OLED HUD and a phone running the AR web app">
              <rect class="sp-d-line sp-d-screen" x="10" y="34" width="104" height="54" rx="4" />
              <circle class="sp-d-line is-soft" cx="34" cy="61" r="13" />
              <g transform="translate(34 61) rotate(90)">
                <line class="sp-mark__path" x1="0" y1="-3" x2="0" y2="-9" />
                <path class="sp-mark__bug" d="M 0 -10 L -3.5 -16 L 3.5 -16 Z" />
              </g>
              <rect class="sp-d-fill" x="56" y="48" width="48" height="4" rx="2" />
              <rect class="sp-d-fill is-soft" x="56" y="59" width="38" height="4" rx="2" />
              <rect class="sp-d-fill is-soft" x="56" y="70" width="44" height="4" rx="2" />
              <text class="sp-d-text" x="62" y="114" text-anchor="middle">I2C OLED HUD</text>
              <line class="sp-d-line is-soft is-dash" x1="114" y1="61" x2="150" y2="61" />
              <rect class="sp-d-line sp-d-screen" x="150" y="4" width="70" height="96" rx="10" />
              <rect class="sp-d-fill is-soft" x="177" y="9" width="16" height="3" rx="1.5" />
              <line class="sp-d-line is-soft is-dash" x1="156" y1="62" x2="214" y2="62" />
              <path class="sp-mark__chev" d="M 200 44 L 209 53 L 200 62" />
              <rect class="sp-d-fill" x="157" y="80" width="40" height="4" rx="2" />
              <rect class="sp-d-fill is-soft" x="157" y="88" width="30" height="4" rx="2" />
              <text class="sp-d-text" x="185" y="114" text-anchor="middle">Phone AR</text>
            </svg>
          </div>
          <figcaption>Diagram. One result, two screens.</figcaption>
        </figure>
      </li>
    </ol>

    <p class="sp-how__demo" data-reveal>
      <a href={demo.href} target="_blank" rel="noopener noreferrer">See it running: the demo video <span aria-hidden="true">↗</span><span class="u-sr-only">(opens in a new tab)</span></a>
      <span>On Carson Secrest's YouTube channel.</span>
    </p>
  </section>

  <section class="case-section sp-section sp-stage">
    <div class="sp-stage__head">
      <div>
        <p class="case-label" data-reveal>The award</p>
        <h2 class="case-h2" data-reveal>3rd place in Google's Best Use of Gemini</h2>
      </div>
      <div class="case-prose" data-reveal>
        <p>SPOOT placed 3rd in Google's Best Use of Gemini track at BeaverHacks 2026, held at Oregon State on {DATES}. The clip walks from the tables up to the stage.</p>
      </div>
    </div>
    <div class="sp-stage__strip">
      <CaseFigure slug="spoot" id="hero" alt="Jakhangir and his teammate on stage under the BeaverHacks banner, both holding prize cards, beside a presenter with a microphone, the audience in the foreground" caption="On stage under the BeaverHacks banner, prize cards in hand." sizes="(max-width: 48em) 100vw, 46vw" class="sp-stage__wide" />
      <CaseClip slug="spoot" id="walk" label="First-person video walking between the hackathon tables up to the stage at BeaverHacks 2026, ending on the view over the hall" caption="From my seat up to the stage, with the hall's sound." class="sp-stage__walk" />
      <CaseFigure slug="spoot" id="cover" alt="Jakhangir, his teammate Carson Secrest and the Google track presenter standing together in a hallway, event lanyards on" caption="With Carson and the Google track presenter." sizes="(max-width: 48em) 50vw, 26vw" class="sp-stage__tall" />
    </div>
  </section>

  <section class="case-section sp-section sp-credits">
    <div class="sp-credits__head">
      <p class="case-label" data-reveal>Credits</p>
      <h2 class="case-h2" data-reveal>A team of two</h2>
      <p class="sp-credits__note" data-reveal>Who built what, as the repository README splits it.</p>
    </div>
    <dl class="sp-credits__list" data-reveal>
      <div class="sp-credits__person">
        <dt>Jakhangir Tynshimov</dt>
        <dd>
          <ul>
            <li>Phone AR layer</li>
            <li>3D-printed glasses hardware</li>
            <li>Raspberry Pi bring-up</li>
          </ul>
        </dd>
      </div>
      <div class="sp-credits__person">
        <dt>Carson Secrest</dt>
        <dd>
          <ul>
            <li>OLED HUD</li>
            <li>Gemini integration in the server</li>
            <li>Direction-of-arrival mapping</li>
          </ul>
        </dd>
      </div>
    </dl>
    <div class="sp-credits__foot" data-reveal>
      <p class="case-label">Built with</p>
      <p class="sp-credits__stack">reSpeaker XVF3800 · Raspberry Pi · Silero VAD · faster-whisper · Gemini Flash · I2C OLED · phone AR web app</p>
      <ul class="case-links">
        {p.links.map((l) => (
          <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} <span aria-hidden="true">↗</span><span class="u-sr-only">(opens in a new tab)</span></a></li>
        ))}
      </ul>
    </div>
  </section>
</CaseLayout>

<script>
  /* The bearing mark turns to the pointer, the way SPOOT turns to a sound.
     Event-driven, no frame loop (invariant 6): a pointer event writes one
     transform on the mark's own layer and a CSS transition eases it there.
     The dial's centre is read once, in page coordinates, and again only
     after a resize or a font swap (invariants 3 and 5). The listeners sit on
     the hero, so nothing runs while it is off screen; under reduced motion
     the mark stays where it rests. */
  const hero = document.querySelector<HTMLElement>(".js-sp-hero");
  const dial = hero?.querySelector<HTMLElement>(".js-sp-dial");
  const mark = hero?.querySelector<HTMLElement>(".js-sp-mark");
  if (hero && dial && mark && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let cx = 0;
    let cy = 0;
    let dead = 0;
    let stale = true;
    let angle = Number(mark.dataset.rest) || 0;
    const measure = () => {
      const r = dial.getBoundingClientRect();
      cx = r.left + r.width / 2 + window.scrollX;
      cy = r.top + r.height / 2 + window.scrollY;
      dead = r.width * 0.12;
      stale = false;
    };
    const aim = (e: PointerEvent) => {
      if (stale) measure();
      const dx = e.pageX - cx;
      const dy = e.pageY - cy;
      if (dx * dx + dy * dy < dead * dead) return;
      const target = (Math.atan2(dx, -dy) * 180) / Math.PI;
      // The shortest way round, so the mark never spins the long way.
      const turn = ((((target - angle) % 360) + 540) % 360) - 180;
      if (Math.abs(turn) < 0.5) return;
      angle += turn;
      mark.style.transform = `rotate(${angle.toFixed(1)}deg)`;
    };
    hero.addEventListener("pointermove", aim, { passive: true });
    hero.addEventListener("pointerdown", aim, { passive: true });
    window.addEventListener("resize", () => (stale = true), { passive: true });
    document.fonts?.ready.then(() => (stale = true));
  }
</script>

<style lang="scss">
  @use "../../styles/helpers/fonts" as *;

  /* ---- Hero: the title where the wearer stands ---- */
  .sp-hero {
    --sp-dial: min(620px, 70svh, 44vw);
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--sp-dial) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "label dial meta"
      "thesis dial meta";
    column-gap: clamp(2rem, 4vw, 4rem);
    padding: clamp(2rem, 5vh, 3.5rem) var(--case-gutter) clamp(3rem, 8vh, 5rem);

    @media (max-width: 72em) {
      --sp-dial: min(100%, 34rem);
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: "label" "dial" "thesis" "meta";
      row-gap: 2rem;
    }
  }

  .sp-hero__label {
    grid-area: label;
  }

  .sp-hero__dial {
    grid-area: dial;
    justify-self: center;
    width: var(--sp-dial);
  }

  .sp-hero__thesis {
    grid-area: thesis;
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  :global(.sp-hero__meta) {
    grid-area: meta;
    align-self: end;
  }

  .sp-dial {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    container-type: inline-size;
    /* The mark's layer is a square turned up to 45°: its corners would
       otherwise widen the page on a phone. */
    overflow: hidden;

    > svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
  }

  .sp-dial__wash {
    fill: var(--case-surface);
  }

  .sp-dial__ring {
    fill: none;
    stroke: var(--case-soft);
    stroke-opacity: 0.55;
    stroke-width: 1;
  }

  .sp-dial__inner {
    fill: none;
    stroke: var(--case-rule);
    stroke-width: 1;
    stroke-dasharray: 2 6;
  }

  .sp-dial__tick {
    stroke: var(--case-soft);
    stroke-opacity: 0.45;
    stroke-width: 1;

    &.is-major {
      stroke-opacity: 0.9;
    }

    &.is-cardinal {
      stroke: var(--case-ink);
      stroke-opacity: 1;
      stroke-width: 1.6;
    }
  }

  .sp-dial__deg text {
    fill: color-mix(in srgb, var(--case-soft) 80%, var(--case-ink));
    font: 400 11px font-family(fraktion);
    letter-spacing: 0.08em;
  }

  .sp-dial__mark {
    position: absolute;
    inset: 0;
    transition: transform 650ms cubic-bezier(0.2, 0.8, 0.2, 1);

    svg {
      display: block;
      width: 100%;
      height: 100%;
    }
  }

