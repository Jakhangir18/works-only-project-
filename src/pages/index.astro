---
import AnimeIntro from "../components/AnimeIntro.astro";
import AnimeHero from "../components/AnimeHero.astro";
import WhyWorkWithMe from "../components/WhyWorkWithMe.astro";
import AnimeRocket from "../components/AnimeRocket.astro";
import AnimeSpace from "../components/AnimeSpace.astro";
import SWork from "../components/SWork.astro";
import AnimeParadise from "../components/AnimeParadise.astro";
import AnimeContact from "../components/AnimeContact.astro";
import { workCards } from "../data/workCards";
import "../styles/global.scss";
---

<html lang="en" class="is-scroll-blocked theme-anime">
  <head>
    <meta charset="utf-8" />

    <title>Jakhangir - Portfolio</title>

    <meta
      name="description"
      content="Jakhangir Tynshimov — computer science and physics at Oregon State. Haptic hardware, sound-locating glasses, camera research for remote chemistry labs, and an industrial inspection tablet."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <meta name="robots" content="noindex, nofollow" />

    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Jakhangir Tynshimov" />
    <meta
      property="og:description"
      content="Computer science and physics at Oregon State. Haptic hardware, sound-locating glasses, camera research for remote chemistry labs, and an industrial inspection tablet."
    />
    <meta property="og:image" content={new URL("/og-home.jpg", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={new URL("/", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Jakhangir Tynshimov" />
    <meta
      name="twitter:description"
      content="Computer science and physics at Oregon State. Haptic hardware, sound-locating glasses, camera research for remote chemistry labs, and an industrial inspection tablet."
    />
    <meta name="twitter:image" content={new URL("/og-home.jpg", Astro.site)} />

    <!-- The light theme's ground. The browser chrome on a phone matches the
         page rather than the old near-black. -->
    <meta name="theme-color" content="#ffffff" />

    <link rel="preload" href="/fonts/Bigger-Display.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/PPFraktionMono-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <!-- Editorial New is not preloaded here: nothing above the fold uses it on
         this page, and a preload the first screen does not need is bandwidth
         taken from the one it does. -->
  </head>

  <body>
    <AnimeIntro />

    <main>
      <AnimeHero />
      {/* The rocket's flight zone wraps the bento: it flies beside it the
          whole way down, then dives on the runway after it. */}
      <AnimeRocket>
        <WhyWorkWithMe />
      </AnimeRocket>
      <AnimeSpace />
      {/* WORK as it was on Vercel: the letter tunnel, entered from the
          star field, with the seven projects as its cards. */}
      <SWork items={workCards} home />
      {/* The timeline as a walk: down from space onto a meadow, and along a
          path from 2022 to now. The campus entries are stops on it. */}
      <AnimeParadise />
      <AnimeContact />
    </main>
  </body>

  <script>
    import { initAnimeSite } from "../utils/AnimeSite";
    initAnimeSite();
  </script>
</html>
